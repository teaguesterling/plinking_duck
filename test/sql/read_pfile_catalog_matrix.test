# unsupported version (v1 path still owns the message)
statement ok
COPY (SELECT '{"pfile_catalog":3,"dataset":"x"}') TO '{TEST_DIR}/v3.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/v3.pfile.json');
----
unsupported

# axes AND concat_dim
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"x","concat_dim":"variants","axes":[]}') TO '{TEST_DIR}/mixed.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/mixed.pfile.json');
----
one or the other

