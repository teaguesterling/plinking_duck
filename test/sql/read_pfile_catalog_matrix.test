# v2 never widens: a prune predicate on a matrix catalog is an error, not silently ignored.
statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json', region := '1:1-100');
----
invalid predicate

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json', variant_index := [0, 1]);
----
invalid predicate
