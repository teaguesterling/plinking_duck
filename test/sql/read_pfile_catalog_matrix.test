# name: test/sql/read_pfile_catalog_matrix.test
# description: read_pfile_catalog v2 — matrix (2-D) catalog: parse + dense cell manifest (P13 phase 1)
# group: [sql]

require plinking_duck

# ===========================================================================
# FIXTURE — dense 2x2 grid: variants split by CHROM={1,2} (one shared .pvar each), samples split by
# GROUP={A,B} (one shared .psam each); 4 cells data/CHROM=i/GROUP=j/cell.pgen. Verification is not
# wired yet, so the cell filesets are copies of one small fileset. PARTITION_BY only creates the
# hive directories the pfile writer needs.
# ===========================================================================

statement ok
COPY (SELECT c AS CHROM, g AS "GROUP", 0 AS x FROM (VALUES ('1'),('2')) a(c), (VALUES ('A'),('B')) b(g))
TO '{TEST_DIR}/data' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"));

statement ok
COPY (SELECT * FROM read_pfile('test/data/pfile_example', genotypes := 'struct')) TO '{TEST_DIR}/data/CHROM=1/GROUP=A/cell' (FORMAT pfile);

# Hand-written v2 catalog.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"dense","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":4},{"value":"2","start":4,"stop":10}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":3},{"value":"B","start":3,"stop":6}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"ref/CHROM={CHROM}/block.pvar","psam":"ref/GROUP={GROUP}/block.psam"}}')
TO '{TEST_DIR}/matrix_dense.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json');
----
4

query TTTT
SELECT ends_with(prefix, 'CHROM=1/GROUP=A/cell'), ends_with(pvar, 'ref/CHROM=1/block.pvar'),
       ends_with(psam, 'ref/GROUP=A/block.psam'), dataset
FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json') WHERE keys['CHROM'] = '1' AND keys['GROUP'] = 'A';
----
true	true	true	dense

# Companions are shared along each axis: 2 distinct .pvar, 2 distinct .psam across 4 cells.
query II
SELECT count(DISTINCT pvar), count(DISTINCT psam) FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json');
----
2	2

# Declared per-block spans and source_ordinal (variants-major).
query IIIII
SELECT source_ordinal, variant_start, variant_stop, sample_start, sample_stop
FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json') ORDER BY source_ordinal;
----
0	0	4	0	3
1	0	4	3	6
2	4	10	0	3
3	4	10	3	6

# Verification is not wired for v2 yet: no cell may claim to be verified.
query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json') WHERE verified;
----
0

# ---------------------------------------------------------------------------
# Negative fixtures
# ---------------------------------------------------------------------------

# unsupported version (v1 path still owns the message)
statement ok
COPY (SELECT '{"pfile_catalog":3,"dataset":"x"}') TO '{TEST_DIR}/v3.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/v3.pfile.json');
----
unsupported

# axes AND concat_dim
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"x","concat_dim":"variants","axes":[]}') TO '{TEST_DIR}/mixed.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/mixed.pfile.json');
----
one or the other

# .pvar templated by a sample-axis key (declared per sample-block)
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"x","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":3}]}]}],"template":{"pfile":"c/{CHROM}/{GROUP}","pvar":"ref/{GROUP}.pvar","psam":"ref/{GROUP}.psam"}}')
TO '{TEST_DIR}/wrongaxis.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/wrongaxis.pfile.json');
----
spec §5

# unknown key type
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"x","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"bogus","values":[{"value":"1","start":0,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":3}]}]}],"template":{"pfile":"c/{CHROM}/{GROUP}","pvar":"ref/{CHROM}.pvar","psam":"ref/{GROUP}.psam"}}')
TO '{TEST_DIR}/badtype.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/badtype.pfile.json');
----
unknown key type

# template references an undeclared key
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"x","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":3}]}]}],"template":{"pfile":"c/{CHROM}/{NOPE}","pvar":"ref/{CHROM}.pvar","psam":"ref/{GROUP}.psam"}}')
TO '{TEST_DIR}/undeclared.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
SELECT * FROM read_pfile_catalog('{TEST_DIR}/undeclared.pfile.json');
----
undeclared key
