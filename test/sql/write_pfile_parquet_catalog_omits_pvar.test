query I
SELECT count(*) FROM (
  SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/mx_txt.pfile.json')
  EXCEPT ALL
  SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/mx_pq.pfile.json'));
