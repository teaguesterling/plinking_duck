# A single group is a valid one-shard cohort (the sharded path, not the plain bundle).
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pgen_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/one' (FORMAT pfile, shard_samples {whole: ['SAMPLE1', 'SAMPLE2', 'SAMPLE3', 'SAMPLE4']});

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('__TEST_DIR__/one/whole/data', pvar := '__TEST_DIR__/one.pvar')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pgen_example'))),
       (SELECT count(*) FROM read_pfile_catalog('__TEST_DIR__/one.pfile.json'));
----
0	1

# ===========================================================================
# NEGATIVE — bind-time rejects (no file is written)
# ===========================================================================

statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
shard_by and shard_samples cannot be combined

# A group that is not a contiguous run of the input sample order.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP3'], b: ['SAMP2', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
contiguous

# A group in a different order than the input samples (within the group).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP2', 'SAMP1'], b: ['SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
contiguous

# Groups listed out of input order (each group is a run, but b comes before a in the input).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8'], a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4']});
----
contiguous

# A sample missing from every group.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3'], b: ['SAMP4', 'SAMP5', 'SAMP6', 'SAMP7']});
----
every sample exactly once

# A sample in two groups.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2'], b: ['SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
more than one group

# An IID that is not an input sample.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'NOPE'], b: ['SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
not an input sample

# An empty group.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: [], b: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
empty

# Not a STRUCT of IID lists.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples ['SAMP1']);
----
shard_samples must be a STRUCT

# A label that is not a safe directory name.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {"a/b": ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
path separator

# Path overrides cannot be combined (the layout generates every path).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, psam '__TEST_DIR__/x.psam', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
shard_samples cannot be combined with pvar/pgen/psam path overrides

# A bare TINYINT[N] LIST carries no sample identity (the existing identity error).
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
needs sample identity

# Sample-orient input (rows are samples, no variant columns): the existing missing-role error.
statement error
COPY (SELECT IID, genotypes FROM read_pfile('test/data/large_example', orient := 'sample'))
TO '__TEST_DIR__/bad' (FORMAT pfile, samples ['SAMP1'], shard_samples {a: ['SAMP1']});
----
CHROM

# Phased input stays rejected (hardcalls only).
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/phased_example', phased := true) ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, samples ['SAMPLE1', 'SAMPLE2', 'SAMPLE3', 'SAMPLE4'], shard_samples {a: ['SAMPLE1', 'SAMPLE2'], b: ['SAMPLE3', 'SAMPLE4']});
----
PHASED

# A label with a glob metacharacter (the reader treats a prefix as a pattern) — only letters,
# digits, '_' and '-' are allowed (review finding: 'b[1]' / 'q?' wrote an unreadable cohort).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {"b[1]": ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
path-safe

statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {"q?": ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
path-safe

# The same IID twice in ONE group names that group once, not "more than one group".
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP1'], b: ['SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
twice in group 'a'

# None of the bind rejects wrote anything.
query I
SELECT count(*) FROM glob('__TEST_DIR__/bad*');
----
0

# ===========================================================================
# NEGATIVE — failures after files open: nothing is orphaned
# ===========================================================================

# An UPSTREAM error in the second chunk (row 2500 of 3000), after the first chunk has been written
# to every shard: no catalog, no finals, no staging left behind. The error() is in a projection
# OVER the sorted subquery, so it fires while rows stream into the sink — not during the sort.
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT,
             CASE WHEN ID = 'var2500' THEN error('boom at var2500') ELSE genotypes END AS genotypes
      FROM (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS))
TO '__TEST_DIR__/mid' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
boom at var2500

query II
SELECT (SELECT count(*) FROM glob('__TEST_DIR__/mid*')),
       (SELECT count(*) FROM glob('__TEST_DIR__/mid/**'));
----
0	0

# A sink-side error (an out-of-range call) mid-stream: same guarantee.
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT,
             CASE WHEN ID = 'var2500' THEN struct_pack(SAMP1 := 7::TINYINT, SAMP2 := 0::TINYINT, SAMP3 := 0::TINYINT, SAMP4 := 0::TINYINT, SAMP5 := 0::TINYINT, SAMP6 := 0::TINYINT, SAMP7 := 0::TINYINT, SAMP8 := 0::TINYINT) ELSE genotypes END AS genotypes
      FROM (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS))
TO '__TEST_DIR__/sinkerr' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
out of range

query II
SELECT (SELECT count(*) FROM glob('__TEST_DIR__/sinkerr*')),
       (SELECT count(*) FROM glob('__TEST_DIR__/sinkerr/**'));
----
0	0

# Zero rows: no shards to finish; nothing written.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') WHERE false)
TO '__TEST_DIR__/zero' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
no rows

query I
SELECT count(*) FROM glob('__TEST_DIR__/zero*');
----
0

# The plain bundle and the variant shard_by path are untouched (covered in write_pfile.test /
# write_pfile_sharded.test); here only confirm a plain bundle still writes after this file's COPYs.
statement ok
COPY (SELECT * FROM read_pfile('test/data/pgen_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/plain' (FORMAT pfile);

query I
SELECT count(*) FROM glob('__TEST_DIR__/plain.*');
