'per205', 'per206', 'per207', 'per208', 'per209', 'per210', 'per211', 'per212', 'per213', 'per214', 'per215', 'per216', 'per217', 'per218', 'per219', 'per220', 'per221', 'per222', 'per223', 'per224', 'per225', 'per226', 'per227', 'per228', 'per229', 'per230', 'per231', 'per232', 'per233', 'per234', 'per235', 'per236', 'per237', 'per238', 'per239', 'per240', 'per241', 'per242', 'per243', 'per244', 'per245', 'per246', 'per247', 'per248', 'per249']});

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile(['__TEST_DIR__/sp/x/data', '__TEST_DIR__/sp/y/data'], combine_samples := 'concatenate', pvar := '__TEST_DIR__/sp.pvar')
