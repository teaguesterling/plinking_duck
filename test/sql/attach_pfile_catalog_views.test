# name: test/sql/attach_pfile_catalog_views.test
# description: the five ATTACH genotype views (tall genotypes, wide genotypes_by_variant / genotypes_by_sample, and their _list forms) on every catalog kind equal read_pfile on the source
# group: [sql]

require plinking_duck

# Spec: docs/superpowers/specs/2026-11-19-attach-genotype-views-design.md, sections 1, 1b and 3. Oracle:
# large_example (3000 variants x 8 samples, IDs var1..var3000) read directly. Kinds: b = the bare
# file set, vs = a v1 variant-sharded catalog, ss = a v1 sample-sharded catalog, mx = a 3 x 2 matrix.

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/vs' (FORMAT pfile, shard_by 'CHROM');

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/ss' (FORMAT pfile, shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3'], b: ['SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/mx' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
ATTACH 'test/data/large_example' AS b (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/vs' AS vs (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/ss' AS ss (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/mx' AS mx (TYPE pfile_catalog);

# Every kind has the five views.
query II
SELECT database_name, list(view_name ORDER BY view_name) FROM duckdb_views()
WHERE database_name IN ('b', 'vs', 'ss', 'mx') AND view_name LIKE 'genotypes%' GROUP BY 1 ORDER BY 1;
----
b	[genotypes, genotypes_by_sample, genotypes_by_sample_list, genotypes_by_variant, genotypes_by_variant_list]
mx	[genotypes, genotypes_by_sample, genotypes_by_sample_list, genotypes_by_variant, genotypes_by_variant_list]
ss	[genotypes, genotypes_by_sample, genotypes_by_sample_list, genotypes_by_variant, genotypes_by_variant_list]
vs	[genotypes, genotypes_by_sample, genotypes_by_sample_list, genotypes_by_variant, genotypes_by_variant_list]

foreach threads 1 4

statement ok
SET threads = ${threads};

# --- b ---
# Tall c.genotypes = genotype orient with freq and CPRA (Review Focus 1).
query I
SELECT count(*) FROM ((SELECT ID, IID, genotype, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM b.genotypes) EXCEPT ALL (SELECT ID, IID, genotype, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', orient := 'genotype', freq := true)) UNION ALL ((SELECT ID, IID, genotype, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', orient := 'genotype', freq := true)) EXCEPT ALL (SELECT ID, IID, genotype, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM b.genotypes)));
----
0

# Wide by variant: one column per IID (Review Focus 2).
query I
SELECT count(*) FROM ((SELECT ID, SAMP1, SAMP2, SAMP3, SAMP4, SAMP5, SAMP6, SAMP7, SAMP8, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM b.genotypes_by_variant) EXCEPT ALL (SELECT ID, SAMP1, SAMP2, SAMP3, SAMP4, SAMP5, SAMP6, SAMP7, SAMP8, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', genotypes := 'columns', freq := true)) UNION ALL ((SELECT ID, SAMP1, SAMP2, SAMP3, SAMP4, SAMP5, SAMP6, SAMP7, SAMP8, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', genotypes := 'columns', freq := true)) EXCEPT ALL (SELECT ID, SAMP1, SAMP2, SAMP3, SAMP4, SAMP5, SAMP6, SAMP7, SAMP8, CPRA, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM b.genotypes_by_variant)));
----
0

# Wide by sample: one column per variant ID.
query I
SELECT count(*) FROM ((SELECT IID, var1, var100, var1100, var3000 FROM b.genotypes_by_sample) EXCEPT ALL (SELECT IID, var1, var100, var1100, var3000 FROM read_pfile('test/data/large_example', orient := 'sample', genotypes := 'columns')) UNION ALL ((SELECT IID, var1, var100, var1100, var3000 FROM read_pfile('test/data/large_example', orient := 'sample', genotypes := 'columns')) EXCEPT ALL (SELECT IID, var1, var100, var1100, var3000 FROM b.genotypes_by_sample)));
----
0

# The list views keep today's shape.
query I
SELECT count(*) FROM b.genotypes_by_variant_list;
----
3000

query I
SELECT count(*) FROM b.genotypes_by_sample_list;
----
8

# List order: element i of a list row is row i of b.samples / b.variants (Review Focus 4).
query II
SELECT count(*), count(*) FILTER (t.genotype IS DISTINCT FROM l.g) FROM
  (SELECT ID, unnest(genotypes) AS g, generate_subscripts(genotypes, 1) AS i FROM b.genotypes_by_variant_list) l
  JOIN (SELECT IID, row_number() OVER () AS i FROM b.samples) s USING (i)
  JOIN b.genotypes t ON t.ID = l.ID AND t.IID = s.IID;
----
24000	0

query II
SELECT count(*), count(*) FILTER (t.genotype IS DISTINCT FROM l.g) FROM
  (SELECT IID, unnest(genotypes) AS g, generate_subscripts(genotypes, 1) AS i FROM b.genotypes_by_sample_list) l
  JOIN (SELECT ID, row_number() OVER () AS i FROM b.variants) v USING (i)
  JOIN b.genotypes t ON t.ID = v.ID AND t.IID = l.IID;
----
24000	0

# Q1 / Q2 / Q3 on the tall view (Review Focus 5).
query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM b.genotypes WHERE ID = 'var100') EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE ID = 'var100') UNION ALL ((SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE ID = 'var100') EXCEPT ALL (SELECT ID, IID, genotype FROM b.genotypes WHERE ID = 'var100')));
----
0

query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM b.genotypes WHERE CHROM = '1' AND POS BETWEEN 3000 AND 4000 AND genotype > 0) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE CHROM = '1' AND POS BETWEEN 3000 AND 4000 AND genotype > 0) UNION ALL ((SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE CHROM = '1' AND POS BETWEEN 3000 AND 4000 AND genotype > 0) EXCEPT ALL (SELECT ID, IID, genotype FROM b.genotypes WHERE CHROM = '1' AND POS BETWEEN 3000 AND 4000 AND genotype > 0)));
----
0

query I
SELECT count(*) FROM ((SELECT DISTINCT IID FROM b.genotypes WHERE ID IN ('var100', 'var200', 'var1100') AND genotype = 2) EXCEPT ALL (SELECT DISTINCT IID FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE ID IN ('var100', 'var200', 'var1100') AND genotype = 2) UNION ALL ((SELECT DISTINCT IID FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE ID IN ('var100', 'var200', 'var1100') AND genotype = 2) EXCEPT ALL (SELECT DISTINCT IID FROM b.genotypes WHERE ID IN ('var100', 'var200', 'var1100') AND genotype = 2)));
----
0

