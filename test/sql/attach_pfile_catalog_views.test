# The tall view's row count.
query I
SELECT count(*) FROM mx.genotypes;
----
24000

# ---------------------------------------------------------------------------
# unique_column_names := true (section 3): a '.', empty or duplicate ID column is named by its CPRA,
# then _<n>. dup: POS 100 and 200 have ID '.', POS 300 and 400 both have ID 'var4' (large_example's
# IDs are var<POS/100>).
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT CHROM, POS,
             CASE WHEN POS IN (100, 200) THEN '.' WHEN POS = 300 THEN 'var4' ELSE ID END AS ID,
             REF, ALT, genotypes
      FROM read_pfile('test/data/large_example', genotypes := 'struct') WHERE CHROM = '1' AND POS <= 500 ORDER BY POS)
TO '{TEST_DIR}/dup' (FORMAT pfile);

query I
SELECT (SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pfile('{TEST_DIR}/dup', orient := 'sample', genotypes := 'columns', unique_column_names := true)))
     = (SELECT ['IID'] || list(CASE WHEN POS IN (100, 200, 400) THEN CHROM || ':' || POS || ':' || REF || ':' || ALT ELSE ID END ORDER BY POS)
        FROM read_pvar('{TEST_DIR}/dup.pvar'));
----
true

# Without the option, a duplicate ID is still an error.
statement error
SELECT * FROM read_pfile('{TEST_DIR}/dup', orient := 'sample', genotypes := 'columns');
----
appears more than once

# The ATTACH by-sample view uses the option.
statement ok
ATTACH '{TEST_DIR}/dup' AS d (TYPE pfile_catalog);

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM d.genotypes_by_sample);
----
6
