# name: test/sql/plink_ld_negative.test
# description: Negative tests for plink_ld table function
# group: [sql]

require plinking_duck

# --- File not found ---

statement error
SELECT * FROM plink_ld('nonexistent.pgen', variant1 := 'rs1', variant2 := 'rs2');
----
plink_ld

# --- Variant not found ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    variant1 := 'NOSUCHVARIANT', variant2 := 'rs2');
----
variant

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    variant1 := 'rs1', variant2 := 'NOSUCHVARIANT');
----
variant

# --- Incomplete pair (only variant1) ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1');
----
both variant1 and variant2

# --- Incomplete pair (only variant2) ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant2 := 'rs2');
----
both variant1 and variant2

# --- No arguments ---

statement error
SELECT * FROM plink_ld();
----

# --- Invalid r2_threshold ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen', r2_threshold := -0.1);
----
r2_threshold

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen', r2_threshold := 1.5);
----
r2_threshold

# --- Invalid window_kb ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen', window_kb := -1);
----
window_kb

# --- Unknown sample ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    variant1 := 'rs1', variant2 := 'rs2',
    samples := ['NOSUCHSAMPLE']);
----
sample

# --- Invalid region format ---

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    region := 'invalid_region', variant1 := 'rs1', variant2 := 'rs2');
----
region

# --- Population-weighted LD parameter errors (maintainer-added for PR #37) ---

# population_column and population_weights are only meaningful together
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'POP');
----
population_column and population_weights must be supplied together

statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_weights := 'A=0.5,B=0.5');
----
population_column and population_weights must be supplied together

# Unknown metadata column
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'NOSUCHCOLUMN', population_weights := 'A=0.5,B=0.5');
----
population_column 'NOSUCHCOLUMN' not found

# A weighted population with no matching samples is an error rather than a
# silently dropped weight -- otherwise the remaining weights are quietly
# renormalized and the caller gets a different statistic than they asked for.
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'POP', population_weights := 'A=0.5,NOSUCHPOP=0.5');
----
no included samples have that POP

# Malformed weight spec
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'POP', population_weights := 'garbage');
----
population_weights entries must be

# All-zero weights
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'POP', population_weights := 'A=0,B=0');
----
at least one positive weight

# Negative weight
statement error
SELECT * FROM plink_ld('test/data/pgen_example.pgen',
    psam := 'test/data/pgen_example_pop.psam',
    variant1 := 'rs1', variant2 := 'rs2',
    population_column := 'POP', population_weights := 'A=-1,B=2');
----
invalid non-negative population weight
