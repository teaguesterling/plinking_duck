# name: test/sql/plink_pgen_header_cache.test
# description: cache tier 1 in the other readers — read_pgen and the plink_* functions decode each .pgen header once per database, shared by their bind, their threads, their next query and read_pfile
# group: [sql]

require plinking_duck

require parquet

# Spec: docs/superpowers/specs/2026-11-20-metadata-cache-tiers-design.md, tier 1 (delivery step 2).
# Each function reads its own copy of large_example (3000 variants x 8 samples), so no decode is
# shared between functions by accident. Two runs of one function: 1 decode in total. Before this
# change these functions bypassed the cache, so the counter stayed 0.

statement ok
SET threads = 4;

statement ok
CREATE TABLE src AS SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS;

foreach fn freq hardy missing ld glm rpgen

statement ok
COPY src TO '{TEST_DIR}/f_{fn}' (FORMAT pfile);

endloop

# --- plink_freq
query I
SELECT plinking_debug_pgen_header_decodes_reset();
----
0

query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/f_freq.pgen');
----
3000

query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/f_freq.pgen', counts := true);
----
3000

query I
SELECT plinking_debug_pgen_header_decodes();
----
1

