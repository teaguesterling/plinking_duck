# --- read_pfile shares the header read_pgen decoded (one entry per file, whichever reader opens it).
query I
SELECT count(genotypes) FROM read_pfile('{TEST_DIR}/f_rpgen');
----
3000

query I
SELECT plinking_debug_pgen_header_decodes();
----
1

# --- plink_score and plink_pca (their own fixtures, read once before in no test above).
query I
SELECT plinking_debug_pgen_header_decodes_reset();
----
0

query I
SELECT count(*) FROM plink_score('test/data/pgen_example.pgen', weights := [1.0, 0.5, -0.5, 2.0]);
----
4

query I
SELECT count(*) FROM plink_score('test/data/pgen_example.pgen', weights := [1.0, 0.5, -0.5, 2.0]);
----
4

query I
SELECT plinking_debug_pgen_header_decodes();
----
1

query I
SELECT plinking_debug_pgen_header_decodes_reset();
----
0

query I
SELECT count(*) > 0 FROM plink_pca('test/data/pca_example.pgen', n_pcs := 3);
----
true

query I
SELECT count(*) > 0 FROM plink_pca('test/data/pca_example.pgen', n_pcs := 3);
----
true

query I
SELECT plinking_debug_pgen_header_decodes();
----
1

# --- The setting turns it off here too.
statement ok
SET plinking_pgen_header_cache = false;

query I
SELECT plinking_debug_pgen_header_decodes_reset();
----
0

query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/f_freq.pgen');
----
3000

query I
SELECT plinking_debug_pgen_header_decodes() >= 1;
----
true
