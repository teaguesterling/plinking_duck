# name: test/sql/plink_select.test
# description: Composable `select :=` STRUCT surface on the routed stat functions
# group: [sql]

require plinking_duck

# Genotype matrix (pgen_example, 4 samples × 4 variants):
#   rs1 [0, 1, 2, NULL]  chr1:10000
#   rs2 [1, 1, 0, 2]     chr1:20000
#   rs3 [2, NULL, 1, 0]  chr1:30000
#   rs4 [0, 0, 1, 2]     chr2:15000

# --- Equivalence: a `select` struct == the same options as individual params ---

# region via select == region via individual param (identical row sets, both ways)
query I
SELECT COUNT(*) FROM (
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(region := '1:10000-20000'))
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen', region := '1:10000-20000'))
  UNION ALL
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen', region := '1:10000-20000')
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(region := '1:10000-20000')))
);
----
0

# samples via select == samples via individual param
query I
SELECT COUNT(*) FROM (
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(samples := [0, 1]), counts := true)
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen', samples := [0, 1], counts := true))
  UNION ALL
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen', samples := [0, 1], counts := true)
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(samples := [0, 1]), counts := true))
);
----
0

# --- Merge / override precedence: individual param wins per-field, select's other field survives ---

# select alone: samples [0,1] on rs1 → alt=1, obs=2*2=4, freq=0.25
query TRI
SELECT ID, ALT_FREQ, OBS_CT FROM plink_freq('test/data/pgen_example.pgen',
    "select" := struct_pack(samples := [0, 1], region := '1:10000-10000'));
----
rs1	0.25	4

# override: individual samples [2,3] WINS (freq 1.0/obs 2, not 0.25/4), AND the
# region '1:10000-10000' from select SURVIVES (still only rs1).
query TRI
SELECT ID, ALT_FREQ, OBS_CT FROM plink_freq('test/data/pgen_example.pgen',
    "select" := struct_pack(samples := [0, 1], region := '1:10000-10000'),
    samples := [2, 3]);
----
rs1	1.0	2

# the overridden form is identical to passing both as individual params
query I
SELECT COUNT(*) FROM (
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen',
       "select" := struct_pack(samples := [0, 1], region := '1:10000-10000'), samples := [2, 3])
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen', samples := [2, 3], region := '1:10000-10000'))
  UNION ALL
  (SELECT * FROM plink_freq('test/data/pgen_example.pgen', samples := [2, 3], region := '1:10000-10000')
   EXCEPT
   SELECT * FROM plink_freq('test/data/pgen_example.pgen',
       "select" := struct_pack(samples := [0, 1], region := '1:10000-10000'), samples := [2, 3]))
);
----
0

# --- select is wired on the other routed functions too (region field applies) ---

query I
SELECT COUNT(*) FROM plink_hardy('test/data/pgen_example.pgen', "select" := struct_pack(region := '1:10000-20000'));
----
2

# --- Field validation ---

# unknown field (catches sample vs samples)
statement error
SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(sample := [0, 1]));
----
unknown field 'sample'

# non-STRUCT select
statement error
SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := 'oops');
----
must be a STRUCT

# variant_range is validated at parse time (hi < lo rejected) even though the stat
# functions do not yet consume that axis
statement error
SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(variant_range := [5, 2]));
----
variant_range

# a well-formed variant_range is accepted but inert for the stat functions (no-op);
# all 4 variants are still returned
query I
SELECT COUNT(*) FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(variant_range := [0, 2]));
----
4

# --- plink_ld: SAMPLE axis only; a region field inside select is IGNORED ---

# select.samples applies on plink_ld (identical to the individual samples param)
query I
SELECT COUNT(*) FROM (
  (SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1', variant2 := 'rs2',
       "select" := struct_pack(samples := [0, 1, 2]))
   EXCEPT
   SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1', variant2 := 'rs2',
       samples := [0, 1, 2]))
  UNION ALL
  (SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1', variant2 := 'rs2',
       samples := [0, 1, 2])
   EXCEPT
   SELECT * FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1', variant2 := 'rs2',
       "select" := struct_pack(samples := [0, 1, 2])))
);
----
0

# a region field in select is ignored by plink_ld — a non-chr:start-end string is
# NOT routed to any region parser, so it does not error (contrast plink_freq below)
query TTI
SELECT ID_A, ID_B, OBS_CT
FROM plink_ld('test/data/pgen_example.pgen', variant1 := 'rs1', variant2 := 'rs2',
    "select" := struct_pack(region := 'ignored-by-ld'));
----
rs1	rs2	3

# the SAME bogus region via select IS parsed by plink_freq (its variant axis is live)
statement error
SELECT * FROM plink_freq('test/data/pgen_example.pgen', "select" := struct_pack(region := 'ignored-by-ld'));
----
region

# --- plink_glm: the one function-specific path (samples-require-psam gate + lazy
# psam load fire off a select-provided `samples`, not just the individual param) ---

# select.samples == individual samples (phenotype is length raw_sample_ct either way)
query I
SELECT COUNT(*) FROM (
  (SELECT * FROM plink_glm('test/data/pgen_example', phenotype := [1.5, 2.3, 3.7, 0.8],
       "select" := struct_pack(samples := [0, 1, 2]))
   EXCEPT
   SELECT * FROM plink_glm('test/data/pgen_example', phenotype := [1.5, 2.3, 3.7, 0.8],
       samples := [0, 1, 2]))
  UNION ALL
  (SELECT * FROM plink_glm('test/data/pgen_example', phenotype := [1.5, 2.3, 3.7, 0.8],
       samples := [0, 1, 2])
   EXCEPT
   SELECT * FROM plink_glm('test/data/pgen_example', phenotype := [1.5, 2.3, 3.7, 0.8],
       "select" := struct_pack(samples := [0, 1, 2])))
);
----
0

# a select-provided `samples` with no psam trips plink_glm's psam-required gate
statement error
SELECT * FROM plink_glm('test/data/pgen_orphan', phenotype := [1.0, 2.0],
    "select" := struct_pack(samples := [0, 1]));
----
requires .psam/.fam file
