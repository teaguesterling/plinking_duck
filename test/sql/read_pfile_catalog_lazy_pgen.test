# name: test/sql/read_pfile_catalog_lazy_pgen.test
# description: read_pfile(catalog :=) takes each cell's counts from the catalog at bind, and opens a cell's .pgen only if the scan keeps it
# group: [sql]

require plinking_duck

# P13-006 §10.5 / stage 5. Bind opened every cell's .pgen header to read two counts that the
# catalog already declares, so a WHERE could not skip the open. Now a lazy read (variant or
# genotype orient, no variants :=) takes the counts from the catalog, and InitGlobal opens the
# .pgen of each cell that survives pruning, and checks it against those counts. Proof: a cell
# with a garbage .pgen binds (DESCRIBE succeeds), a WHERE that prunes it succeeds, and a read that
# keeps it errors. The oracle is large_example (3000 variants x 8 samples, CHROM 1/2/3 x 1000).
statement ok
SET threads = 4;

# Clean 3 x 2 matrix (CHROM blocks x {lo: SAMP1-4, hi: SAMP5-8}).
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/mx' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

# bad: cell (CHROM=2, hi) has a garbage .pgen. bad0: cell (CHROM=1, lo), the first cell, does.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/bad/CHROM=2/GROUP=hi/data.pgen' (FORMAT csv, header false);

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad0' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/bad0/CHROM=1/GROUP=lo/data.pgen' (FORMAT csv, header false);

# v1 shard_by: shard CHROM=2 (not the first shard) has a garbage .pgen.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/badvs' (FORMAT pfile, shard_by 'CHROM');

statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/badvs/CHROM=2/data.pgen' (FORMAT csv, header false);

# ---------------------------------------------------------------------------
# Bind does not open a cell's .pgen; the scan opens only the cells it keeps
# ---------------------------------------------------------------------------
statement ok
DESCRIBE SELECT * FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json');

statement ok
DESCRIBE SELECT * FROM read_pfile(catalog := '{TEST_DIR}/bad0.pfile.json', orient := 'genotype');

# The corruption is real: a read that keeps the cell errors, and names its .pgen.
statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json');
----
data.pgen

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '2';
----
data.pgen

# A WHERE that prunes the cell never opens it.
query II
SELECT (SELECT count(*) FROM (
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM IN ('1', '3')
          EXCEPT ALL
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile('test/data/large_example') WHERE CHROM IN ('1', '3'))),
       (SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM IN ('1', '3'));
----
0	2000

# The first cell is deferred too.
query I
SELECT count(*) FROM (
  SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/bad0.pfile.json', orient := 'genotype') WHERE CHROM = '3'
  EXCEPT ALL
  SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE CHROM = '3');
----
0

# Through the ATTACH view.
statement ok
ATTACH '{TEST_DIR}/bad.pfile.json' AS c (TYPE pfile_catalog);

query I
SELECT count(*) FROM c.genotypes_by_variant_list WHERE CHROM = '1';
----
1000

# v1 shard_by: a later shard is deferred.
statement ok
DESCRIBE SELECT * FROM read_pfile(catalog := '{TEST_DIR}/badvs.pfile.json');

query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/badvs.pfile.json') WHERE CHROM = '3';
----
1000

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/badvs.pfile.json');
----
data.pgen

# A prepared statement opens the cells again on each run.
statement ok
PREPARE p AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '3';

query I
EXECUTE p;
----
1000

query I
EXECUTE p;
----
1000

# ---------------------------------------------------------------------------
# The counts the catalog declares are still checked, now when the cell opens
# ---------------------------------------------------------------------------
# mmv: cell (CHROM=2, hi) holds 10 variants, but its block declares 1000.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/mmv' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', samples := [4, 5, 6, 7], genotypes := 'struct') WHERE CHROM = '2' ORDER BY POS LIMIT 10)
TO '{TEST_DIR}/mmv/CHROM=2/GROUP=hi/data' (FORMAT pfile, force true);

# mms: cell (CHROM=2, hi) holds 3 samples, but its block declares 4.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/mms' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', samples := [4, 5, 6], genotypes := 'struct') WHERE CHROM = '2' ORDER BY POS)
TO '{TEST_DIR}/mms/CHROM=2/GROUP=hi/data' (FORMAT pfile, force true);

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mmv.pfile.json');
----
but its blocks declare 1000 variants x 4 samples

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mms.pfile.json', orient := 'genotype');
----
but its blocks declare 1000 variants x 4 samples

# A pruned cell is not checked (it is not read).
query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mmv.pfile.json') WHERE CHROM = '1';
----
1000

# Sample orient with no filter checks each cell's header at InitGlobal, not at bind: DESCRIBE opens
# no .pgen, and the scan checks every cell that it reads.
statement ok
DESCRIBE SELECT * FROM read_pfile(catalog := '{TEST_DIR}/mmv.pfile.json', orient := 'sample');

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mmv.pfile.json', orient := 'sample');
----
but its blocks declare 1000 variants x 4 samples

# A filter parameter reads genotypes at bind, so there it checks every cell at bind.
statement error
DESCRIBE SELECT * FROM read_pfile(catalog := '{TEST_DIR}/mmv.pfile.json', orient := 'sample', include_genotypes := ['het']);
----
but its blocks declare 1000 variants x 4 samples

# ---------------------------------------------------------------------------
# Results equal the full read
# ---------------------------------------------------------------------------
query II
SELECT (SELECT count(*) FROM (
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json')
          EXCEPT ALL
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile('test/data/large_example'))),
       (SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json'));
----
0	3000

query I
SELECT count(*) FROM (
  SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype', samples := [1, 6])
  EXCEPT ALL
  SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype', samples := [1, 6]));
----
0

# plinking_pgen_io := 'localize' copies a cell's .pgen at InitGlobal, after pruning, and only if the
# scan keeps the cell (issue #114). Before, it copied every cell at bind: on a remote store, one
# slice query downloaded the whole cohort.
statement ok
SET plinking_localize_dir = '{TEST_DIR}/loc';

statement ok
SET plinking_pgen_io = 'localize';

query I
SELECT count(*) FROM (
  SELECT ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json') WHERE CHROM = '2'
  EXCEPT ALL
  SELECT ID, genotypes::TINYINT[] FROM read_pfile('test/data/large_example') WHERE CHROM = '2');
----
0

# A pruned cell is not copied. A garbage .pgen alone cannot show that (a copy does not parse its
# bytes), so gone.pfile.json is mx's catalog pointed at part/, a grid written without CHROM 2:
# both CHROM=2 cells have NO .pgen. A copy of a pruned cell would fail with "cannot open".
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') WHERE CHROM <> '2' ORDER BY CHROM, POS)
TO '{TEST_DIR}/part' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT replace(content, '"mx/', '"part/') FROM read_text('{TEST_DIR}/mx.pfile.json'))
TO '{TEST_DIR}/gone.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1f');

query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/gone.pfile.json') WHERE CHROM = '1';
----
1000

query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/gone.pfile.json', orient := 'genotype') WHERE IID = 'SAMP1' AND CHROM = '3';
----
1000

# A kept cell that has no .pgen still errors (the copy fails).
statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/gone.pfile.json', orient := 'genotype') WHERE IID = 'SAMP1' AND CHROM = '2';
----
CHROM=2/GROUP=lo/data.pgen

# A pruned cell is not copied or opened: the garbage cell (CHROM=2, hi) is outside the WHERE.
query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '1';
----
1000

# A kept cell is copied, and the scan reads the copy: the error names the local temp copy, not
# bad/CHROM=2/GROUP=hi/data.pgen. If the deferred open read the original, this would fail.
statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '2';
----
plinking_localize_

# Genotype orient, IID prune: a sample shard with no selected sample is not copied.
query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json', orient := 'genotype') WHERE IID = 'SAMP1';
----
3000

# Sample orient with no filter defers its headers to InitGlobal too: the hi shards are not copied.
query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json', orient := 'sample') WHERE IID = 'SAMP1';
----
1

# A prepared statement runs InitGlobal again on the same bind data; the second run reads the
# copies made by the first.
statement ok
PREPARE loc_q AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json') WHERE CHROM = '3';

query I
EXECUTE loc_q;
----
1000

query I
EXECUTE loc_q;
----
1000

statement ok
DEALLOCATE loc_q;

# The policy is fixed at bind. A SET after PREPARE does not stop the deferred copy: the kept garbage
# cell is still read from its temp copy (the error names it).
statement ok
PREPARE loc_bad AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '2';

statement ok
SET plinking_pgen_io = 'auto';

statement error
EXECUTE loc_bad;
----
plinking_localize_

statement ok
DEALLOCATE loc_bad;

statement ok
SET plinking_pgen_io = 'localize';

# Every temp copy is removed when its query ends.
query I
SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*');
----
0

# A prepared statement keeps its temp copies until DEALLOCATE, so a glob between EXECUTE and
# DEALLOCATE counts the cells that one run copied.

# v1 shard_by: cell 0 opens at bind (its header gives the sample count), but it is copied only if
# the scan keeps it. Before, cell 0 was copied at bind, so this WHERE made 2 copies.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/vs' (FORMAT pfile, shard_by 'CHROM');

statement ok
PREPARE loc_v1 AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/vs.pfile.json') WHERE CHROM = '2';

query I
EXECUTE loc_v1;
----
1000

query I
SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*');
----
1

statement ok
DEALLOCATE loc_v1;

# A kept cell 0 is copied.
statement ok
PREPARE loc_v1 AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/vs.pfile.json') WHERE CHROM = '1';

query I
EXECUTE loc_v1;
----
1000

query I
SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*');
----
1

statement ok
DEALLOCATE loc_v1;

# The bind-time header open of an uncopied cell 0 reads the original, so it goes through the VFS
# when the path needs it (a file:// path here, as an s3:// or http:// path would): a native
# fopen of 'file://...' fails.
statement ok
PREPARE loc_v1 AS SELECT count(*) FROM read_pfile(catalog := 'file://{WORKING_DIR}/{TEST_DIR}/vs.pfile.json') WHERE CHROM = '2';

query I
EXECUTE loc_v1;
----
1000

query I
SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*');
----
1

statement ok
DEALLOCATE loc_v1;

# A failed copy removes its partial temp. dirg is part/ with its (CHROM=2, lo) .pgen made a
# directory: the copy opens it, creates the temp, then fails on the first read. A prepared
# statement retries the copy on each EXECUTE; before, each retry left one more temp.
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') WHERE CHROM <> '2' ORDER BY CHROM, POS)
TO '{TEST_DIR}/dirg' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT '2' AS CHROM, 'lo' AS "GROUP", 1 AS x) TO '{TEST_DIR}/dirg' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"), OVERWRITE_OR_IGNORE);

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/dirg/CHROM=2/GROUP=lo/data.pgen' (FORMAT csv, PER_THREAD_OUTPUT true);

statement ok
COPY (SELECT replace(content, '"mx/', '"dirg/') FROM read_text('{TEST_DIR}/mx.pfile.json'))
TO '{TEST_DIR}/dirg.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1f');

statement ok
PREPARE loc_dir AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/dirg.pfile.json') WHERE CHROM = '2';

statement error
EXECUTE loc_dir;
----
CHROM=2/GROUP=lo/data.pgen

statement error
EXECUTE loc_dir;
----
CHROM=2/GROUP=lo/data.pgen

statement error
EXECUTE loc_dir;
----
CHROM=2/GROUP=lo/data.pgen

query I
SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*');
----
0

statement ok
DEALLOCATE loc_dir;

# The temp dir is fixed at bind, like the policy: a SET of plinking_localize_dir after PREPARE does
# not move the copies.
statement ok
PREPARE loc_q AS SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json') WHERE CHROM = '3';

statement ok
SET plinking_localize_dir = '{TEST_DIR}/loc2';

query I
EXECUTE loc_q;
----
1000

query II
SELECT (SELECT count(*) FROM glob('{TEST_DIR}/loc/plinking_localize_*')),
       (SELECT count(*) FROM glob('{TEST_DIR}/loc2/plinking_localize_*'));
----
2	0

statement ok
DEALLOCATE loc_q;

statement ok
SET plinking_localize_dir = '{TEST_DIR}/loc';

# The deferred header open takes its route (native or VFS) from bind, as the scan's opens do. A
# catalog prepared under 'auto' on a file:// path (the VFS route, as for s3:// or http://) still
# opens its cells through the VFS after a SET to 'native' or 'localize'. Before, the header open
# re-read the policy and tried a native fopen of 'file://...'.
statement ok
SET plinking_pgen_io = 'auto';

statement ok
PREPARE url_q AS SELECT count(*) FROM read_pfile(catalog := 'file://{WORKING_DIR}/{TEST_DIR}/mx.pfile.json') WHERE CHROM = '3';

statement ok
SET plinking_pgen_io = 'native';

query I
EXECUTE url_q;
----
1000

statement ok
DEALLOCATE url_q;

statement ok
SET plinking_pgen_io = 'auto';

statement ok
PREPARE url_q AS SELECT count(*) FROM read_pfile(catalog := 'file://{WORKING_DIR}/{TEST_DIR}/mx.pfile.json') WHERE CHROM = '3';

statement ok
SET plinking_pgen_io = 'localize';

query I
EXECUTE url_q;
----
1000

statement ok
DEALLOCATE url_q;

query I
SELECT count(*) FROM glob('{TEST_DIR}/loc*/plinking_localize_*');
----
0

statement ok
RESET plinking_pgen_io;

statement ok
RESET plinking_localize_dir;

# ---------------------------------------------------------------------------
# The deferred header open goes through DuckDB's VFS when the policy says so
# ---------------------------------------------------------------------------
# plinking_pgen_io := 'vfs' routes every .pgen open through the VFS (the path a remote catalog
# takes), including the header open that now runs at InitGlobal.
statement ok
SET plinking_pgen_io = 'vfs';

query I
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '3';
----
1000

statement error
SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/bad.pfile.json') WHERE CHROM = '2';
----
data.pgen

query II
SELECT (SELECT count(*) FROM (
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json')
          EXCEPT ALL
          SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM read_pfile('test/data/large_example'))),
       (SELECT count(*) FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json'));
----
0	3000

statement ok
RESET plinking_pgen_io;
