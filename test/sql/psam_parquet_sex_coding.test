# name: test/sql/psam_parquet_sex_coding.test
# description: the analyses' .psam.parquet load (LoadSampleInfoFromParquet) codes SEX of any type as before its speed-up: DuckDB's cast to BIGINT, then 1 = male, 2 = female, else (NULL, cast failure, other) unknown
# group: [sql]

require plinking_duck

require parquet

# Guard for a speed-up (2026-11-23, 8M samples: the load took 6.4 s, one Value per row for SEX).
# The expected rows were recorded from the build before the change, so the change keeps them.
# sexchr_example: M1 M2 M3 F1 F2 F3. y1 OBS_CT counts the samples coded male (chrY is read for
# males only); x1's counts change with the female / male split.
# Note: this rule rounds ('1.9' -> 2, 2.6 -> 3); read_pfile's SEX column follows stoi ('1.9' -> 1).

statement ok
COPY (SELECT * FROM (VALUES ('M1', 1::BIGINT), ('M2', 1), ('M3', 1), ('F1', 2), ('F2', 2), ('F3', 2)) t(IID, SEX))
TO '{TEST_DIR}/a.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM (VALUES ('M1', '1'), ('M2', '01'), ('M3', '1.9'), ('F1', '2'), ('F2', 'x'), ('F3', 'NA')) t(IID, SEX))
TO '{TEST_DIR}/b.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM (VALUES ('M1', 1.0::DOUBLE), ('M2', 1.4), ('M3', 2.6), ('F1', 2.0), ('F2', 0.0), ('F3', NULL)) t(IID, SEX))
TO '{TEST_DIR}/c.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM (VALUES ('M1', ' 1'), ('M2', '2 '), ('M3', '+1'), ('F1', '-1'), ('F2', '3'), ('F3', '')) t(IID, SEX))
TO '{TEST_DIR}/d.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM (VALUES ('M1', true), ('M2', true), ('M3', false), ('F1', false), ('F2', NULL), ('F3', true)) t(IID, SEX))
TO '{TEST_DIR}/e.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM (VALUES ('M1', 3000000000::BIGINT), ('M2', -9), ('M3', 1), ('F1', 2), ('F2', 1), ('F3', 2)) t(IID, SEX))
TO '{TEST_DIR}/f.psam.parquet' (FORMAT parquet);

# A lower-case column name, with FID and an extra column (a wide companion).
statement ok
COPY (SELECT * FROM (VALUES ('fa', 'M1', 1, 0.5), ('fa', 'M2', 1, 0.1), ('fb', 'M3', 2, 0.2), ('fb', 'F1', 2, 0.3), ('fc', 'F2', 2, 0.4), ('fc', 'F3', 2, 0.6)) t(fid, iid, sex, pheno))
TO '{TEST_DIR}/g.psam.parquet' (FORMAT parquet);

query TTIII
SELECT f, ID, OBS_CT, HET_CT, HOM_ALT_CT FROM (
  SELECT 'a' f, * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/a.psam.parquet')
  UNION ALL SELECT 'b', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/b.psam.parquet')
  UNION ALL SELECT 'c', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/c.psam.parquet')
  UNION ALL SELECT 'd', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/d.psam.parquet')
  UNION ALL SELECT 'e', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/e.psam.parquet')
  UNION ALL SELECT 'f', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/f.psam.parquet')
  UNION ALL SELECT 'g', * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/g.psam.parquet'))
WHERE ID IN ('x1', 'y1') ORDER BY f, ID;
----
a	x1	9	1	2
a	y1	3	0	2
b	x1	6	1	1
b	y1	2	0	2
c	x1	4	1	1
c	y1	2	0	2
d	x1	4	0	1
d	y1	2	0	1
e	x1	3	0	2
e	y1	2	0	2
f	x1	6	1	1
f	y1	1	0	0
g	x1	10	1	2
g	y1	2	0	2

# samples := by name over that companion (IID and FID loaded with SEX).
query TI
SELECT ID, OBS_CT FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := '{TEST_DIR}/g.psam.parquet', samples := ['M1', 'F3'])
WHERE ID IN ('x1', 'y1') ORDER BY ID;
----
x1	3
y1	1
