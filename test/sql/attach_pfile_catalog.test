# The uneven grid's sample-oriented view: 3 samples, each with all 4 variants.
query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM um.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample') WHERE IID <> 'SAMPLE4')),
       (SELECT count(*) FROM um.genotypes_by_sample);
----
0	3
