# name: test/sql/attach_pfile_catalog.test
# description: ATTACH (TYPE pfile_catalog) exposes a cohort matrix as a schema of relations
# group: [sql]

require plinking_duck

require parquet

# ---------------------------------------------------------------------------
# Fixture: the same dense 2x2 matrix as read_pfile_catalog_matrix.test —
# variants split by CHROM={1,2}, samples by GROUP={A,B}, 4 real cells, 2 shared
# .pvar (per CHROM) and 2 shared .psam (per GROUP).
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT c AS CHROM, g AS "GROUP", 0 AS x FROM (VALUES ('1'),('2')) a(c), (VALUES ('A'),('B')) b(g))
TO '{TEST_DIR}/data' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"));

statement ok
COPY (SELECT c AS CHROM, 0 AS x FROM (VALUES ('1'),('2')) a(c)) TO '{TEST_DIR}/refv' (FORMAT csv, PARTITION_BY (CHROM));

statement ok
COPY (SELECT g AS "GROUP", 0 AS x FROM (VALUES ('A'),('B')) b(g)) TO '{TEST_DIR}/refs' (FORMAT csv, PARTITION_BY ("GROUP"));

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/data/CHROM=1/GROUP=A/cell' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/data/CHROM=1/GROUP=B/cell' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/data/CHROM=2/GROUP=A/cell' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/data/CHROM=2/GROUP=B/cell' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refv/CHROM=1/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/refv/CHROM=2/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refs/GROUP=A/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refs/GROUP=B/blk' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"dense","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_dense.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

# ---------------------------------------------------------------------------
# Task 1: the ATTACH seam, with c.genotypes
# ---------------------------------------------------------------------------
statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS c (TYPE pfile_catalog);

# c.genotypes equals read_pfile over the same four surviving cell prefixes
# (self-checking: no hardcoded count, proves the baked view reads the real cells).
query T
SELECT (SELECT count(*) FROM c.genotypes) =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell', '{TEST_DIR}/data/CHROM=2/GROUP=B/cell']));
----
true

# and the relation is non-empty
query T
SELECT count(*) > 0 FROM c.genotypes;
----
true

# ---------------------------------------------------------------------------
# Task 2: grid relations — c.cells, c.variant_blocks, c.sample_blocks
# ---------------------------------------------------------------------------

# c.cells is exactly the shipped manifest reader.
query T
SELECT (SELECT count(*) FROM c.cells) =
       (SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json'));
----
true

query I
SELECT count(*) FROM c.cells;
----
4

# c.variant_blocks: the variant-axis tiling (CHROM), distinct spans.
query TII
SELECT "CHROM", variant_start, variant_stop FROM c.variant_blocks ORDER BY variant_start;
----
1	0	3
2	3	4

# c.sample_blocks: the sample-axis tiling (GROUP), distinct spans.
query TII
SELECT "GROUP", sample_start, sample_stop FROM c.sample_blocks ORDER BY sample_start;
----
A	0	2
B	2	4

# ---------------------------------------------------------------------------
# Task 3: axis relations — c.variants, c.samples, c.genotypes_by_sample
# ---------------------------------------------------------------------------

# c.variants: pvar union over the two distinct variant-block .pvar (read_pvar takes a LIST).
query T
SELECT (SELECT count(*) FROM c.variants) =
       (SELECT count(*) FROM read_pvar(['{TEST_DIR}/refv/CHROM=1/blk.pvar',
                                         '{TEST_DIR}/refv/CHROM=2/blk.pvar']));
----
true

# c.samples: psam union over the two distinct sample-block .psam (read_psam is single-file,
# so the view is a UNION ALL BY NAME).
query T
SELECT (SELECT count(*) FROM c.samples) =
       (SELECT count(*) FROM (
          SELECT * FROM read_psam('{TEST_DIR}/refs/GROUP=A/blk.psam')
          UNION ALL BY NAME
          SELECT * FROM read_psam('{TEST_DIR}/refs/GROUP=B/blk.psam')));
----
true

# c.genotypes_by_sample: the same cells, sample-oriented.
query T
SELECT (SELECT count(*) FROM c.genotypes_by_sample) =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell', '{TEST_DIR}/data/CHROM=2/GROUP=B/cell'],
          orient := 'sample'));
----
true

# ---------------------------------------------------------------------------
# Task 4: behaviour gates — pushdown, read-only, discoverability, detach
# ---------------------------------------------------------------------------

# WHERE on c.genotypes rides read_pfile's pushdown and returns the correct subset.
query T
SELECT (SELECT count(*) FROM c.genotypes WHERE CHROM = '1') =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell', '{TEST_DIR}/data/CHROM=2/GROUP=B/cell'])
        WHERE CHROM = '1');
----
true

# read-only: a write to the attached catalog errors.
statement error
CREATE TABLE c.scratch AS SELECT 1 AS x;
----

# discoverability: the seven relations are listed under database c.
query I
SELECT count(*) FROM (SHOW ALL TABLES) WHERE database = 'c';
----
7

# detach, then re-attach the same name.
statement ok
DETACH c;

statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS c (TYPE pfile_catalog);

query T
SELECT count(*) > 0 FROM c.genotypes;
----
true

# An explicit READ_ONLY attach also works (and is still read-only). The catalog is always
# read-only, so passing READ_ONLY must not fail with ":memory: read-only" (review finding 1).
statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS cro (TYPE pfile_catalog, READ_ONLY);

query T
SELECT count(*) > 0 FROM cro.genotypes;
----
true

statement error
CREATE TABLE cro.scratch AS SELECT 1 AS x;
----

# ---------------------------------------------------------------------------
# Task 4b: holes and the empty (all-holes) catalog — reuse the data/refv/refs above
# ---------------------------------------------------------------------------

# A hole at (CHROM=2, GROUP=B): three present cells.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"holed","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"},"holes":[{"CHROM":"2","GROUP":"B"}]}')
TO '{TEST_DIR}/matrix_hole.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_hole.pfile.json' AS h (TYPE pfile_catalog);

# the hole drops one cell: three present in c.cells.
query I
SELECT count(*) FROM h.cells;
----
3

# h.genotypes reads only the three present cells.
query T
SELECT (SELECT count(*) FROM h.genotypes) =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell']));
----
true

# All cells are holes: ATTACH fails loud (no present cells to read), not a crash.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"empty","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"},"holes":[{"CHROM":"1"},{"CHROM":"2"}]}')
TO '{TEST_DIR}/matrix_empty.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
ATTACH '{TEST_DIR}/matrix_empty.pfile.json' AS e (TYPE pfile_catalog);
----
no present cells
