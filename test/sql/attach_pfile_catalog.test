# name: test/sql/attach_pfile_catalog.test
# description: ATTACH (TYPE pfile_catalog) exposes a cohort matrix as a schema of relations
# group: [sql]

require plinking_duck

require parquet

# ---------------------------------------------------------------------------
# Fixture: the same dense 2x2 matrix as read_pfile_catalog_matrix.test —
# variants split by CHROM={1,2}, samples by GROUP={A,B}, 4 real cells, 2 shared
# .pvar (per CHROM) and 2 shared .psam (per GROUP).
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT c AS CHROM, g AS "GROUP", 0 AS x FROM (VALUES ('1'),('2')) a(c), (VALUES ('A'),('B')) b(g))
TO '{TEST_DIR}/data' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"));

statement ok
COPY (SELECT c AS CHROM, 0 AS x FROM (VALUES ('1'),('2')) a(c)) TO '{TEST_DIR}/refv' (FORMAT csv, PARTITION_BY (CHROM));

statement ok
COPY (SELECT g AS "GROUP", 0 AS x FROM (VALUES ('A'),('B')) b(g)) TO '{TEST_DIR}/refs' (FORMAT csv, PARTITION_BY ("GROUP"));

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/data/CHROM=1/GROUP=A/cell' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/data/CHROM=1/GROUP=B/cell' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/data/CHROM=2/GROUP=A/cell' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/data/CHROM=2/GROUP=B/cell' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refv/CHROM=1/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/refv/CHROM=2/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refs/GROUP=A/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/refs/GROUP=B/blk' (FORMAT pfile, samples ['S3', 'S4']);

statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"dense","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_dense.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

# ---------------------------------------------------------------------------
# Task 1: the ATTACH seam, with c.genotypes
# ---------------------------------------------------------------------------
statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS c (TYPE pfile_catalog);

# c.genotypes equals read_pfile over the same four surviving cell prefixes
# (self-checking: no hardcoded count, proves the baked view reads the real cells).
query T
SELECT (SELECT count(*) FROM c.genotypes) =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell', '{TEST_DIR}/data/CHROM=2/GROUP=B/cell']));
----
true

# and the relation is non-empty
query T
SELECT count(*) > 0 FROM c.genotypes;
----
true

# c.genotypes FANS OUT per cell (docs/formats/pfile_catalog.md): one row per variant x sample
# block, each row carrying that block's samples only. Truth oracle: the source, sliced to group A
# (S1, S2) and to group B (S3, S4) — not a re-read of the same cells.
query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM c.genotypes
        EXCEPT ALL (SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 1, 2) FROM read_pfile('test/data/pfile_example')
                    UNION ALL SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 3, 4) FROM read_pfile('test/data/pfile_example')))),
       (SELECT count(*) FROM c.genotypes);
----
0	8

# ---------------------------------------------------------------------------
# Task 2: grid relations — c.cells, c.variant_blocks, c.sample_blocks
# ---------------------------------------------------------------------------

# c.cells is exactly the shipped manifest reader.
query T
SELECT (SELECT count(*) FROM c.cells) =
       (SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/matrix_dense.pfile.json'));
----
true

query I
SELECT count(*) FROM c.cells;
----
4

# c.variant_blocks: the variant-axis tiling (CHROM), distinct spans.
query TII
SELECT "CHROM", variant_start, variant_stop FROM c.variant_blocks ORDER BY variant_start;
----
1	0	3
2	3	4

# c.sample_blocks: the sample-axis tiling (GROUP), distinct spans.
query TII
SELECT "GROUP", sample_start, sample_stop FROM c.sample_blocks ORDER BY sample_start;
----
A	0	2
B	2	4

# ---------------------------------------------------------------------------
# Task 3: axis relations — c.variants, c.samples, c.genotypes_by_sample
# ---------------------------------------------------------------------------

# c.variants: pvar union over the two distinct variant-block .pvar (read_pvar takes a LIST).
query T
SELECT (SELECT count(*) FROM c.variants) =
       (SELECT count(*) FROM read_pvar(['{TEST_DIR}/refv/CHROM=1/blk.pvar',
                                         '{TEST_DIR}/refv/CHROM=2/blk.pvar']));
----
true

# c.samples: psam union over the two distinct sample-block .psam (read_psam is single-file,
# so the view is a UNION ALL BY NAME).
query T
SELECT (SELECT count(*) FROM c.samples) =
       (SELECT count(*) FROM (
          SELECT * FROM read_psam('{TEST_DIR}/refs/GROUP=A/blk.psam')
          UNION ALL BY NAME
          SELECT * FROM read_psam('{TEST_DIR}/refs/GROUP=B/blk.psam')));
----
true

# c.genotypes_by_sample over a grid with TWO sample blocks is the 2-D read: one row per sample,
# every variant from every variant block. (Before it, a sample-oriented read of every cell put
# group B's genotypes under group A's IIDs: 2 rows for 4 samples; S1's row carried S3's calls.)
# Truth oracle: the source itself, IIDs renamed.
query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM c.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample'))),
       (SELECT count(*) FROM c.genotypes_by_sample);
----
0	4

query T
SELECT genotypes::TINYINT[] = (SELECT genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample') WHERE IID = 'SAMPLE3')
FROM c.genotypes_by_sample WHERE IID = 'S3';
----
true

# ---------------------------------------------------------------------------
# Task 4: behaviour gates — pushdown, read-only, discoverability, detach
# ---------------------------------------------------------------------------

# WHERE on c.genotypes rides read_pfile's pushdown and returns the correct subset.
query T
SELECT (SELECT count(*) FROM c.genotypes WHERE CHROM = '1') =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell', '{TEST_DIR}/data/CHROM=2/GROUP=B/cell'])
        WHERE CHROM = '1');
----
true

# read-only: a write to the attached catalog errors.
statement error
CREATE TABLE c.scratch AS SELECT 1 AS x;
----

# discoverability: the seven relations are listed under database c.
query I
SELECT count(*) FROM (SHOW ALL TABLES) WHERE database = 'c';
----
7

# detach, then re-attach the same name.
statement ok
DETACH c;

statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS c (TYPE pfile_catalog);

query T
SELECT count(*) > 0 FROM c.genotypes;
----
true

# An explicit READ_ONLY attach also works (and is still read-only). The catalog is always
# read-only, so passing READ_ONLY must not fail with ":memory: read-only" (review finding 1).
statement ok
ATTACH '{TEST_DIR}/matrix_dense.pfile.json' AS cro (TYPE pfile_catalog, READ_ONLY);

query T
SELECT count(*) > 0 FROM cro.genotypes;
----
true

statement error
CREATE TABLE cro.scratch AS SELECT 1 AS x;
----

# ---------------------------------------------------------------------------
# Task 4b: holes and the empty (all-holes) catalog — reuse the data/refv/refs above
# ---------------------------------------------------------------------------

# A hole at (CHROM=2, GROUP=B): three present cells.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"holed","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"},"holes":[{"CHROM":"2","GROUP":"B"}]}')
TO '{TEST_DIR}/matrix_hole.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_hole.pfile.json' AS h (TYPE pfile_catalog);

# the hole drops one cell: three present in c.cells.
query I
SELECT count(*) FROM h.cells;
----
3

# h.genotypes reads only the three present cells.
query T
SELECT (SELECT count(*) FROM h.genotypes) =
       (SELECT count(*) FROM read_pfile([
          '{TEST_DIR}/data/CHROM=1/GROUP=A/cell', '{TEST_DIR}/data/CHROM=1/GROUP=B/cell',
          '{TEST_DIR}/data/CHROM=2/GROUP=A/cell']));
----
true

# All cells are holes: ATTACH fails loud (no present cells to read), not a crash.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"empty","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"},"holes":[{"CHROM":"1"},{"CHROM":"2"}]}')
TO '{TEST_DIR}/matrix_empty.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement error
ATTACH '{TEST_DIR}/matrix_empty.pfile.json' AS e (TYPE pfile_catalog);
----
no present cells

# A filter that matches no row returns no row.
query I
SELECT count(*) FROM c.genotypes_by_sample WHERE IID = 'NOBODY';
----
0

# A 1 x N grid (one variant block, two sample blocks): every cell keeps its .psam elsewhere (refs/).
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"row","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_row.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_row.pfile.json' AS mr (TYPE pfile_catalog);

query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM mr.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample', region := '1'))),
       (SELECT count(*) FROM mr.genotypes_by_sample);
----
0	4

# A HOLED grid (an absent cell) has no defined 2-D meaning yet: its sample-oriented view errors at
# bind — under count(*), a filter that matches no row, and DESCRIBE.
statement error
SELECT count(*) FROM h.genotypes_by_sample;
----
hole

statement error
SELECT * FROM h.genotypes_by_sample WHERE IID = 'NOBODY';
----
hole

statement error
DESCRIBE h.genotypes_by_sample;
----
hole

# A holed matrix with ONE sample block: the hole removes a whole variant block, so the read is
# well defined and c.genotypes_by_sample keeps working (it did before the 2-D read; review
# finding). The cells have sibling companions. Oracle: the source, CHROM 1, S1 and S2.
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"colhole","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"},"holes":[{"CHROM":"2"}]}')
TO '{TEST_DIR}/matrix_colhole.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_colhole.pfile.json' AS ch (TYPE pfile_catalog);

query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM ch.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), list_slice(genotypes::TINYINT[], 1, 3) FROM read_pfile('test/data/pfile_example', orient := 'sample') WHERE IID IN ('SAMPLE1', 'SAMPLE2'))),
       (SELECT count(*) FROM ch.genotypes_by_sample);
----
0	2

# ---------------------------------------------------------------------------
# A matrix with ONE sample block (2 variant blocks x 1 sample block) is a variant-sharded cohort
# over one shared .psam: BOTH genotype views read correctly. Oracle: the source, sliced to S1, S2.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"col","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2}]}]}],"template":{"pfile":"data/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_col.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_col.pfile.json' AS mc (TYPE pfile_catalog);

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes::TINYINT[] FROM mc.genotypes
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) FROM read_pfile('test/data/pfile_example'))),
       (SELECT count(*) FROM mc.genotypes);
----
0	4

query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM mc.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample') WHERE IID IN ('SAMPLE1', 'SAMPLE2'))),
       (SELECT count(*) FROM mc.genotypes_by_sample);
----
0	2

# ---------------------------------------------------------------------------
# TEMPLATED matrices: each cell is a bare .pgen (FORMAT pgen writes no companions), and the
# catalog's templates name ONE .pvar per variant block and ONE .psam per sample block — the v2
# format's own layout (a per-cell .pvar is impossible when the pvar template uses only variant
# keys). c.genotypes must read each cell with its templated companions. Before this fix it failed
# with "cannot find .pvar" on any such matrix.
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT c AS CHROM, g AS "GROUP", 0 AS x FROM (VALUES ('1'),('2')) a(c), (VALUES ('A'),('B')) b(g))
TO '{TEST_DIR}/tdata' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"));

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/tdata/CHROM=1/GROUP=A/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/tdata/CHROM=1/GROUP=B/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/tdata/CHROM=2/GROUP=A/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/tdata/CHROM=2/GROUP=B/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"tmpl","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":4}]}]}],"template":{"pfile":"tdata/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_tmpl.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_tmpl.pfile.json' AS tm (TYPE pfile_catalog);

# Equal sample blocks (2 + 2): a fixed ARRAY, as read_pfile's own 'auto' gives one cell.
query T
SELECT DISTINCT typeof(genotypes) FROM tm.genotypes;
----
TINYINT[2]

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, genotypes::TINYINT[] FROM tm.genotypes
        EXCEPT ALL (SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 1, 2) FROM read_pfile('test/data/pfile_example')
                    UNION ALL SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 3, 4) FROM read_pfile('test/data/pfile_example')))),
       (SELECT count(*) FROM tm.genotypes);
----
0	8

# A WHERE still reaches each cell's read.
query I
SELECT count(*) FROM tm.genotypes WHERE CHROM = '2';
----
2

# The templated grid's sample-oriented view: the 2-D read through the templated companions.
query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM tm.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample'))),
       (SELECT count(*) FROM tm.genotypes_by_sample);
----
0	4

# ONE sample block, templated: a variant-sharded read whose cells have no sibling .pvar/.psam
# (it failed with "cannot find .pvar" before).
statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"tcol","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2}]}]}],"template":{"pfile":"tdata/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"refs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_tcol.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_tcol.pfile.json' AS tc (TYPE pfile_catalog);

query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes::TINYINT[] FROM tc.genotypes_by_sample
        EXCEPT ALL SELECT replace(IID, 'SAMPLE', 'S'), genotypes::TINYINT[] FROM read_pfile('test/data/pfile_example', orient := 'sample') WHERE IID IN ('SAMPLE1', 'SAMPLE2'))),
       (SELECT count(*) FROM tc.genotypes_by_sample);
----
0	2

# UNEVEN sample blocks (A = S1,S2; B = S3 only): the widths differ, so the column falls back to a
# LIST (read_pfile's own ARRAY-or-LIST rule, lifted to the grid). Each row's list holds its block's
# samples.
statement ok
COPY (SELECT c AS CHROM, g AS "GROUP", 0 AS x FROM (VALUES ('1'),('2')) a(c), (VALUES ('A'),('B')) b(g))
TO '{TEST_DIR}/udata' (FORMAT csv, PARTITION_BY (CHROM, "GROUP"));

statement ok
COPY (SELECT g AS "GROUP", 0 AS x FROM (VALUES ('A'),('B')) b(g)) TO '{TEST_DIR}/urefs' (FORMAT csv, PARTITION_BY ("GROUP"));

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/urefs/GROUP=A/blk' (FORMAT pfile, samples ['S1', 'S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/urefs/GROUP=B/blk' (FORMAT pfile, samples ['S3']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/udata/CHROM=1/GROUP=A/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1')
TO '{TEST_DIR}/udata/CHROM=1/GROUP=B/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/udata/CHROM=2/GROUP=A/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/udata/CHROM=2/GROUP=B/cell.pgen' (FORMAT pgen);

statement ok
COPY (SELECT '{"pfile_catalog":2,"dataset":"uneven","axes":[{"name":"variants","keys":[{"name":"CHROM","type":"enum","values":[{"value":"1","start":0,"stop":3},{"value":"2","start":3,"stop":4}]}]},{"name":"samples","keys":[{"name":"GROUP","type":"enum","values":[{"value":"A","start":0,"stop":2},{"value":"B","start":2,"stop":3}]}]}],"template":{"pfile":"udata/CHROM={CHROM}/GROUP={GROUP}/cell","pvar":"refv/CHROM={CHROM}/blk.pvar","psam":"urefs/GROUP={GROUP}/blk.psam"}}')
TO '{TEST_DIR}/matrix_uneven.pfile.json' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER '\x01');

statement ok
ATTACH '{TEST_DIR}/matrix_uneven.pfile.json' AS um (TYPE pfile_catalog);

query T
SELECT DISTINCT typeof(genotypes) FROM um.genotypes;
----
TINYINT[]

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, genotypes FROM um.genotypes
        EXCEPT ALL (SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 1, 2) FROM read_pfile('test/data/pfile_example')
                    UNION ALL SELECT CHROM, POS, ID, list_slice(genotypes::TINYINT[], 3, 3) FROM read_pfile('test/data/pfile_example')))),
       (SELECT count(*) FROM um.genotypes);
