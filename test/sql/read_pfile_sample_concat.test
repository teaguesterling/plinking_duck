        EXCEPT ALL (SELECT * FROM read_pfile('__TEST_DIR__/pq_a', orient := 'sample', samples := ['per0', 'per36'])
                    UNION ALL SELECT * FROM read_pfile('__TEST_DIR__/pq_b', orient := 'sample', samples := ['per37', 'per249'])))),
       (SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample', samples := ['per0', 'per36', 'per37', 'per249']));
