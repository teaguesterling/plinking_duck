# name: test/sql/read_pfile_sample_concat.test
# description: combine_samples := 'concatenate' — sample-sharded filesets (same variants, disjoint samples) read as one cohort. Oracle: concatenating the contiguous sample splits reproduces the unsplit fileset in every mode.
# group: [sql]

require plinking_duck

# Fixtures (test/data/generate_test_data.sh, split_by_samples): each *_cat_* shard is a
# contiguous sample range of its source fileset, written by plink2 --keep --make-pgen.
#   pca_cat_a + pca_cat_b              = pca_example    (37 + 213 samples, 500 variants)
#   le_cat_a + le_cat_b + le_cat_c     = large_example  (1 + 2 + 5 samples, 3000 variants)
#   phased_cat_a + phased_cat_b        = phased_example (1 + 3 samples)
#   dosage_cat_a + dosage_cat_b        = dosage_example (1 + 3 samples)
# pca_cat_b has NO .pvar on purpose: only shard 0's .pvar (or pvar :=) is read.
# Each comparison prints (symmetric EXCEPT ALL difference, row count); 0 = identical multisets.

# --- Shape: shared variants, Σ samples, IIDs in shard order ---
query III
SELECT count(*), min(len(genotypes)), max(len(genotypes))
FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate');
----
500	250	250

# genotypes := 'columns' names one column per IID, in output sample order (after CHROM..ALT).
query TTTT
SELECT c[6], c[42], c[43], c[255] FROM (
  SELECT list(column_name) AS c FROM (DESCRIBE SELECT * FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate', genotypes := 'columns'))
);
----
per0	per36	per37	per249

# Value-level: the first 37 genotypes of each variant are shard a's, the rest shard b's.
query I
SELECT count(*) FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate') c
JOIN read_pfile('test/data/pca_cat_a') a USING (ID)
JOIN read_pfile('test/data/pca_cat_b', pvar := 'test/data/pca_cat_a.pvar') b USING (ID)
WHERE c.genotypes::TINYINT[] IS DISTINCT FROM (a.genotypes::TINYINT[] || b.genotypes::TINYINT[]);
----
0

# variant orient, default array
query II
SELECT (SELECT count(*) FROM (SELECT * FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate') EXCEPT ALL SELECT * FROM read_pfile('test/data/pca_example'))) + (SELECT count(*) FROM (SELECT * FROM read_pfile('test/data/pca_example') EXCEPT ALL SELECT * FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate'))),
       (SELECT count(*) FROM (SELECT * FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate')));
----
0	500

