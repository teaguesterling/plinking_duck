        EXCEPT ALL SELECT * FROM read_pfile(['test/data/le_cat_a','test/data/le_cat_b','test/data/le_cat_c'], combine_samples := 'concatenate'))),
       (SELECT count(*) FROM read_pfile(['test/data/le_cat_a','test/data/le_cat_b','test/data/le_cat_c'], combine_samples := 'disjoint'));
