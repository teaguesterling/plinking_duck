# ===========================================================================
# PARQUET .psam companions in concat mode. Each shard gets a .psam.parquet (with SEX and PHENO1)
# beside its .pgen, which companion discovery prefers. The oracle reads each shard alone (the
# single-file parquet path) and unions them: the concatenated read must pair every IID with the
# same metadata AND the same genotypes, so a misordered metadata load fails the comparison.
# ===========================================================================
require parquet

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pca_cat_a', genotypes := 'struct'))
TO '__TEST_DIR__/pq_a' (FORMAT pfile);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pca_cat_b', pvar := 'test/data/pca_example.pvar', genotypes := 'struct'))
TO '__TEST_DIR__/pq_b' (FORMAT pfile);

statement ok
COPY (SELECT * FROM read_psam('test/data/pca_cat_a.psam')) TO '__TEST_DIR__/pq_a.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT * FROM read_psam('test/data/pca_cat_b.psam')) TO '__TEST_DIR__/pq_b.psam.parquet' (FORMAT parquet);

# Sample orient: psam columns come from the parquet companions, in shard order.
query II
SELECT (SELECT count(*) FROM (SELECT * FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample')
        EXCEPT ALL (SELECT * FROM read_pfile('__TEST_DIR__/pq_a', orient := 'sample') UNION ALL SELECT * FROM read_pfile('__TEST_DIR__/pq_b', orient := 'sample')))),
       (SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample'));
----
0	250

# The concatenated genotypes still equal the source, and the metadata reached every sample.
query II
SELECT (SELECT count(*) FROM (SELECT IID, genotypes FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample')
        EXCEPT ALL SELECT IID, genotypes FROM read_pfile('test/data/pca_example', orient := 'sample'))),
       (SELECT count(PHENO1) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample'));
----
0	250

# Genotype orient (125000 rows), and a projection of ONE psam column (the projection-aware load).
query II
SELECT (SELECT count(*) FROM (SELECT * FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'genotype')
        EXCEPT ALL (SELECT * FROM read_pfile('__TEST_DIR__/pq_a', orient := 'genotype') UNION ALL SELECT * FROM read_pfile('__TEST_DIR__/pq_b', orient := 'genotype')))),
       (SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'genotype'));
----
0	125000

query I
SELECT count(*) FROM (SELECT ID, IID, genotype FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'genotype')
        EXCEPT ALL SELECT ID, IID, genotype FROM read_pfile('test/data/pca_example', orient := 'genotype'));
----
0

