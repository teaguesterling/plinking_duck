# Parquet shards whose columns differ.
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pca_cat_b', pvar := 'test/data/pca_example.pvar', genotypes := 'struct'))
TO '__TEST_DIR__/pq_c' (FORMAT pfile);

statement ok
COPY (SELECT *, 1 AS extra FROM read_psam('test/data/pca_cat_b.psam')) TO '__TEST_DIR__/pq_c.psam.parquet' (FORMAT parquet);

statement error
SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_c'], combine_samples := 'concatenate', orient := 'sample');
----
.psam columns differ across sample shards

# disjoint through the parquet full-metadata path (sample + genotype orient): the IIDs come from
# the multi-source parquet query.
statement error
SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_a'], combine_samples := 'disjoint', orient := 'sample');
----
appears in both

statement error
SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_a'], combine_samples := 'disjoint', orient := 'genotype');
----
appears in both

query I
SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'disjoint', orient := 'sample');
----
250

# A psam column that collides with the internal ordering columns is rejected clearly at bind.
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pca_cat_a', genotypes := 'struct'))
TO '__TEST_DIR__/pq_x' (FORMAT pfile);

statement ok
COPY (SELECT *, 7 AS file_row_number FROM read_psam('test/data/pca_cat_a.psam')) TO '__TEST_DIR__/pq_x.psam.parquet' (FORMAT parquet);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pca_cat_b', pvar := 'test/data/pca_example.pvar', genotypes := 'struct'))
TO '__TEST_DIR__/pq_y' (FORMAT pfile);

statement ok
COPY (SELECT *, 7 AS file_row_number FROM read_psam('test/data/pca_cat_b.psam')) TO '__TEST_DIR__/pq_y.psam.parquet' (FORMAT parquet);

statement error
SELECT count(*) FROM read_pfile(['__TEST_DIR__/pq_x','__TEST_DIR__/pq_y'], combine_samples := 'concatenate', orient := 'sample');
----
reserved

# Turning companions off reads the writer's text .psam files instead (IID only).
statement ok
SET plinking_use_parquet_companions = false;

query II
SELECT count(*), count(DISTINCT IID) FROM read_pfile(['__TEST_DIR__/pq_a','__TEST_DIR__/pq_b'], combine_samples := 'concatenate', orient := 'sample');
----
250	250

statement ok
RESET plinking_use_parquet_companions;
