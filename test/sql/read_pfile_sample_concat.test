       (SELECT count(*) > 0 FROM (SELECT * FROM read_pfile(['test/data/pca_cat_a','test/data/pca_cat_b'], combine_samples := 'concatenate', orient := 'sample', genotypes := 'counts', include_genotypes := ['hom_alt'])));
