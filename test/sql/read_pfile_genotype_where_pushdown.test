# With include_genotypes := as well, the two intersect (here: nothing).
query I
SELECT count(*) FROM read_pfile('test/data/large_example', orient := 'genotype', include_genotypes := ['het']) WHERE genotype = 2;
----
0

query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype', include_genotypes := ['het', 'hom_alt']) WHERE genotype = 2) EXCEPT ALL (SELECT ID, IID, genotype FROM t WHERE genotype = 2) UNION ALL ((SELECT ID, IID, genotype FROM t WHERE genotype = 2) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype', include_genotypes := ['het', 'hom_alt']) WHERE genotype = 2)));
----
0

# With samples :=.
query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype', samples := ['SAMP1', 'SAMP2', 'SAMP5']) WHERE genotype > 0) EXCEPT ALL (SELECT ID, IID, genotype FROM t WHERE genotype > 0 AND IID IN ('SAMP1', 'SAMP2', 'SAMP5')) UNION ALL ((SELECT ID, IID, genotype FROM t WHERE genotype > 0 AND IID IN ('SAMP1', 'SAMP2', 'SAMP5')) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype', samples := ['SAMP1', 'SAMP2', 'SAMP5']) WHERE genotype > 0)));
----
0

# A sample-sharded matrix with WHERE IID (count_filter_subset must be built and rebuilt).
query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype') WHERE genotype = 2 AND IID IN ('SAMP2', 'SAMP6')) EXCEPT ALL (SELECT ID, IID, genotype FROM t WHERE genotype = 2 AND IID IN ('SAMP2', 'SAMP6')) UNION ALL ((SELECT ID, IID, genotype FROM t WHERE genotype = 2 AND IID IN ('SAMP2', 'SAMP6')) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype') WHERE genotype = 2 AND IID IN ('SAMP2', 'SAMP6'))));
----
0

# freq stays the unfiltered counts.
query I
SELECT count(*) FROM ((SELECT DISTINCT ID, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', orient := 'genotype', freq := true) WHERE genotype = 2) EXCEPT ALL (SELECT ID, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', freq := true) WHERE ID IN (SELECT ID FROM t WHERE genotype = 2)) UNION ALL ((SELECT ID, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', freq := true) WHERE ID IN (SELECT ID FROM t WHERE genotype = 2)) EXCEPT ALL (SELECT DISTINCT ID, ALT_FREQ, OBS_CT, HOM_REF_CT, HET_CT, HOM_ALT_CT, MISSING_CT FROM read_pfile('test/data/large_example', orient := 'genotype', freq := true) WHERE genotype = 2)));
----
0

