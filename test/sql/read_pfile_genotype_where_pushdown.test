# name: test/sql/read_pfile_genotype_where_pushdown.test
# description: in genotype orient, a WHERE on genotype compiles into the scan's genotype filter (as include_genotypes); the rows equal the unpushed answer
# group: [sql]

require plinking_duck

# Spec: docs/superpowers/specs/2026-11-19-attach-genotype-views-design.md, section 2b. Oracle: a table
# copy of the read, filtered by the same WHERE (no pushdown). large_example has missing calls
# (SAMP2: 750), so the NULL semantics are exercised. The counter shows that the compile happened.

statement ok
CREATE TABLE t AS SELECT * FROM read_pfile('test/data/large_example', orient := 'genotype');

query I
SELECT count(*) FILTER (genotype IS NULL) > 0 AND count(DISTINCT genotype) = 3 FROM t;
----
true

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/mx' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

foreach threads 1 4

statement ok
SET threads = ${threads};

# WHERE genotype = 0
statement ok
SELECT plinking_debug_genotype_where_pushed_reset();

query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE genotype = 0) EXCEPT ALL (SELECT ID, IID, genotype FROM t WHERE genotype = 0) UNION ALL ((SELECT ID, IID, genotype FROM t WHERE genotype = 0) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile('test/data/large_example', orient := 'genotype') WHERE genotype = 0)));
----
0

query I
SELECT plinking_debug_genotype_where_pushed();
----
1

