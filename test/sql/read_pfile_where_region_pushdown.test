SELECT count(*) FROM ((SELECT ID, genotypes FROM read_pfile('{TEST_DIR}/A') WHERE POS BETWEEN 100 AND 300) EXCEPT ALL (SELECT ID, genotypes FROM read_pfile('test/data/large_example') WHERE POS BETWEEN 100 AND 300) UNION ALL ((SELECT ID, genotypes FROM read_pfile('test/data/large_example') WHERE POS BETWEEN 100 AND 300) EXCEPT ALL (SELECT ID, genotypes FROM read_pfile('{TEST_DIR}/A') WHERE POS BETWEEN 100 AND 300)));
