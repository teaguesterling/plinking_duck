# matrix catalog, orient := 'genotype'
query I
SELECT count(*) FROM ((SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype') WHERE CHROM = '2' AND POS BETWEEN 5000 AND 7000) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype', region := '2:5000-7000')) UNION ALL ((SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype', region := '2:5000-7000')) EXCEPT ALL (SELECT ID, IID, genotype FROM read_pfile(catalog := '{TEST_DIR}/mx.pfile.json', orient := 'genotype') WHERE CHROM = '2' AND POS BETWEEN 5000 AND 7000)));
----
0

# pushes nothing: CHROM IN ('1', '2') AND POS < 500
query I
SELECT count(*) FROM ((SELECT ID, genotypes FROM read_pfile('{TEST_DIR}/A') WHERE CHROM IN ('1', '2') AND POS < 500) EXCEPT ALL (SELECT ID, genotypes FROM read_pfile('test/data/large_example') WHERE CHROM IN ('1', '2') AND POS < 500) UNION ALL ((SELECT ID, genotypes FROM read_pfile('test/data/large_example') WHERE CHROM IN ('1', '2') AND POS < 500) EXCEPT ALL (SELECT ID, genotypes FROM read_pfile('{TEST_DIR}/A') WHERE CHROM IN ('1', '2') AND POS < 500)));
----
0

