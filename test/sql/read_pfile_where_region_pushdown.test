# An explicit region and a WHERE on another contig: zero rows, no error (Review Focus 2).
query I
SELECT count(*) FROM read_pfile('test/data/large_example', region := '1:100-5000') WHERE CHROM = '2';
----
0

# An explicit region and a narrower WHERE: their intersection.
query I
SELECT count(*) FROM read_pfile('test/data/large_example', region := '1:100-5000') WHERE CHROM = '1' AND POS BETWEEN 3000 AND 9000;
----
21

# A contig name the file does not use: zero rows (Review Focus 3).
query I
SELECT count(*) FROM read_pfile('{TEST_DIR}/A') WHERE CHROM = 'chr1';
----
0

endloop

# A prepared statement run twice (Review Focus 5). RED on 6f78387, like the queries above.
statement ok
PREPARE q AS SELECT count(*) FROM read_pfile('{TEST_DIR}/A', pvar := '{TEST_DIR}/drop3.pvar.parquet') WHERE CHROM = '1' AND POS BETWEEN 10000 AND 20000;

query I
EXECUTE q;
----
101

query I
EXECUTE q;
----
101
