# name: test/sql/write_psam_parquet_standalone.test
# description: standalone COPY ... (FORMAT psam, psam_parquet) emits '<psam>.parquet' (both identity modes), and a rewrite without the option drops a stale companion at InitGlobal — before the new text .psam is written — so even an upstream-query error cannot leave a new .psam beside an old companion.
# group: [sql]

require plinking_duck

require parquet

# ===========================================================================
# OUT_OF_BAND identity (samples [...]) + psam_parquet writes the companion.
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/oob.psam' (FORMAT psam, samples ['s1', 's2', 's3'], psam_parquet);

query I
SELECT IID FROM read_parquet('{TEST_DIR}/oob.psam.parquet');
----
s1
s2
s3

# Minimal IID-only column set, IID VARCHAR (a fixture that stops writing the parquet, or writes a
# different schema, fails here).
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_parquet('{TEST_DIR}/oob.psam.parquet'));
----
IID	VARCHAR

# ===========================================================================
# ROW_STREAM identity (per-row IID column): the companion holds the IIDs in WRITE order, not sorted.
# ===========================================================================

statement ok
COPY (SELECT iid FROM (VALUES ('b'), ('a'), ('c')) t(iid)) TO '{TEST_DIR}/rs.psam' (FORMAT psam, psam_parquet);

query I
SELECT IID FROM read_parquet('{TEST_DIR}/rs.psam.parquet');
----
b
a
c

# ===========================================================================
# Zero-row ROW_STREAM: a header-only .psam writes a valid, empty single-column companion (not a crash).
# (OUT_OF_BAND `samples []` is rejected by the text writer — "a .psam needs at least one IID" — so the
# zero-row case must be a row-stream with no rows.)
# ===========================================================================

statement ok
COPY (SELECT iid FROM (VALUES ('x')) t(iid) WHERE false) TO '{TEST_DIR}/empty.psam' (FORMAT psam, psam_parquet);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/empty.psam.parquet');
----
0

# ===========================================================================
# `psam` path override: the companion follows the OVERRIDE, not the COPY target.
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/ignored.psam' (FORMAT psam, psam '{TEST_DIR}/ovr.psam', samples ['o1'], psam_parquet);

query I
SELECT IID FROM read_parquet('{TEST_DIR}/ovr.psam.parquet');
----
o1

query I
SELECT count(*) FROM glob('{TEST_DIR}/ignored.psam.parquet');
----
0

# ===========================================================================
# force rewrite WITH psam_parquet replaces the old companion in place — exactly one, new IIDs.
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/oob.psam' (FORMAT psam, samples ['n1', 'n2'], psam_parquet, force);

query I
SELECT count(*) FROM glob('{TEST_DIR}/oob.psam.parquet');
----
1

query I
SELECT IID FROM read_parquet('{TEST_DIR}/oob.psam.parquet');
----
n1
n2

# ===========================================================================
# Stale-drop (§6a): a rewrite WITHOUT psam_parquet drops a pre-existing companion. The standalone
# psam writer never produces a consistent companion across a rewrite, so any surviving one is stale
# and would be read as current (wrong sample identity).
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/x.psam' (FORMAT psam, samples ['a', 'b', 'c'], psam_parquet);

query I
SELECT count(*) FROM glob('{TEST_DIR}/x.psam.parquet');
----
1

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/x.psam' (FORMAT psam, samples ['p', 'q'], force);

query I
SELECT count(*) FROM glob('{TEST_DIR}/x.psam.parquet');
----
0

# Override variant: the drop keys on target_path (= the `psam` override), not the COPY target.
statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/ig2.psam' (FORMAT psam, psam '{TEST_DIR}/ovr2.psam', samples ['a'], psam_parquet);

query I
SELECT count(*) FROM glob('{TEST_DIR}/ovr2.psam.parquet');
----
1

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/ig2.psam' (FORMAT psam, psam '{TEST_DIR}/ovr2.psam', samples ['z'], force);

query I
SELECT count(*) FROM glob('{TEST_DIR}/ovr2.psam.parquet');
----
0

# ===========================================================================
# Error-path invariant (§6a): an OUT_OF_BAND rewrite whose feeding query throws mid-stream skips
# Finalize, but the stale companion is dropped at InitGlobal — before the new text .psam is written —
# so no stale companion survives. The throw is column-dependent (1 // (i-2) hits 0 at i=2) so it is a
# RUNTIME error after InitGlobal, not a constant-folded bind error before it. A Finalize-only drop
# fails this case.
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/y.psam' (FORMAT psam, samples ['a1', 'a2'], psam_parquet);

query I
SELECT count(*) FROM glob('{TEST_DIR}/y.psam.parquet');
----
1

statement error
COPY (SELECT 1 // (i - 2) AS boom FROM range(5) t(i)) TO '{TEST_DIR}/y.psam' (FORMAT psam, samples ['b1', 'b2'], force);
----

query I
SELECT count(*) FROM glob('{TEST_DIR}/y.psam.parquet');
----
0

# Override + error path: the §6a InitGlobal drop keys on the `psam` override (target_path), so even a
# throwing out-of-band rewrite leaves no stale companion at the override location.
statement ok
COPY (SELECT 1 AS x) TO '{TEST_DIR}/ig3.psam' (FORMAT psam, psam '{TEST_DIR}/ovr3.psam', samples ['e1'], psam_parquet);

query I
SELECT count(*) FROM glob('{TEST_DIR}/ovr3.psam.parquet');
----
1

statement error
COPY (SELECT 1 // (i - 2) AS boom FROM range(5) t(i)) TO '{TEST_DIR}/ig3.psam' (FORMAT psam, psam '{TEST_DIR}/ovr3.psam', samples ['e2'], force);
----

query I
SELECT count(*) FROM glob('{TEST_DIR}/ovr3.psam.parquet');
----
0

# ===========================================================================
# Fresh write with psam_parquet to a path DuckDB's ExpandPath rewrites (file:// here, also ~). The
# COPY target is expanded before InitGlobal (g.path), but target_path is captured raw at bind; if the
# Finalize move compares them as RAW strings they differ for a fresh (no-tmp_) write, and the move
# branch deletes the just-written companion (and cleanup then the .psam). The comparison must be
# expanded-vs-expanded. Regression test: both the companion and the text .psam must survive.
# ===========================================================================

statement ok
COPY (SELECT 1 AS x) TO 'file://{TEMP_DIR_ABSOLUTE}/furl.psam' (FORMAT psam, samples ['f1', 'f2'], psam_parquet);

query I
SELECT IID FROM read_parquet('{TEMP_DIR_ABSOLUTE}/furl.psam.parquet');
----
f1
f2

query I
SELECT count(*) FROM glob('{TEMP_DIR_ABSOLUTE}/furl.psam');
----
1
