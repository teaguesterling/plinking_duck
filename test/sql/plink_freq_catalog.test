# name: test/sql/plink_freq_catalog.test
# description: plink_freq reads pfile catalogs (variant-sharded, sample-sharded, matrix) with the values of the un-sharded source
# group: [sql]

require plinking_duck

# The oracle for every query is plink_freq over the un-sharded source .pgen. A catalog read must give
# the same rows and the same values. Variant blocks concatenate in catalog order. Counts add across
# sample blocks. On chrX, chrY and chrMT the counts depend on SEX, which comes from each sample
# block's .psam. The writer emits IID-only .psam files, so the setup below writes them again with SEX.
#
# Each row comparison is EXCEPT ALL in both directions over the full row (a NULL matches a NULL), so
# the order of the rows does not matter at threads = 4. The order is checked at threads = 1.

# ---------------------------------------------------------------------------
# Catalogs over large_example (3000 variants x 8 samples, chromosomes 1, 2, 3)
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/lv' (FORMAT pfile, shard_by 'CHROM');

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/ls' (FORMAT pfile, shard_samples {a: ['SAMP1'], b: ['SAMP2', 'SAMP3'], c: ['SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/lm' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

# ---------------------------------------------------------------------------
# Catalogs over sexchr_example (chromosomes 1, PAR1, X, Y, MT; males M1-M3, females F1-F3)
# ---------------------------------------------------------------------------
statement ok
COPY (SELECT * FROM read_pfile('test/data/sexchr_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/sv' (FORMAT pfile, shard_by 'CHROM');

statement ok
COPY (SELECT * FROM (VALUES ('#IID', 'SEX'), ('M1', '1'), ('M2', '1'), ('M3', '1'), ('F1', '2'), ('F2', '2'), ('F3', '2')))
TO '{TEST_DIR}/sv.psam' (FORMAT csv, delim '\t', header false, quote '');

statement ok
COPY (SELECT * FROM read_pfile('test/data/sexchr_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/ss' (FORMAT pfile, shard_samples {a: ['M1', 'M2'], b: ['M3', 'F1', 'F2', 'F3']});

statement ok
COPY (SELECT * FROM (VALUES ('#IID', 'SEX'), ('M1', '1'), ('M2', '1')))
TO '{TEST_DIR}/ss/a/data.psam' (FORMAT csv, delim '\t', header false, quote '');

statement ok
COPY (SELECT * FROM (VALUES ('#IID', 'SEX'), ('M3', '1'), ('F1', '2'), ('F2', '2'), ('F3', '2')))
TO '{TEST_DIR}/ss/b/data.psam' (FORMAT csv, delim '\t', header false, quote '');

statement ok
COPY (SELECT * FROM read_pfile('test/data/sexchr_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/sm' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['M1', 'M2', 'M3'], b: ['F1', 'F2', 'F3']});

statement ok
COPY (SELECT * FROM (VALUES ('#IID', 'SEX'), ('M1', '1'), ('M2', '1'), ('M3', '1')))
TO '{TEST_DIR}/sm/GROUP=a/samples.psam' (FORMAT csv, delim '\t', header false, quote '');

statement ok
COPY (SELECT * FROM (VALUES ('#IID', 'SEX'), ('F1', '2'), ('F2', '2'), ('F3', '2')))
TO '{TEST_DIR}/sm/GROUP=b/samples.psam' (FORMAT csv, delim '\t', header false, quote '');

# A matrix whose .psam files are the writer's IID-only ones: no SEX.
statement ok
COPY (SELECT * FROM read_pfile('test/data/sexchr_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/snosex' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['M1', 'M2', 'M3'], b: ['F1', 'F2', 'F3']});

# The fixture must make SEX matter: on x1, y1 and mt1 the sex-aware counts differ from raw counts.
query I
SELECT count(*) FROM read_pfile('test/data/sexchr_example', genotypes := 'stats') r
JOIN plink_freq('test/data/sexchr_example.pgen', counts := true) f USING (ID)
WHERE 2 * r.genotypes.n IS DISTINCT FROM f.OBS_CT OR r.genotypes.af IS DISTINCT FROM f.ALT_FREQ;
----
3

# ---------------------------------------------------------------------------
# Order: at one thread the catalog rows come in catalog variant order. large_example is sorted, so
# that is the source order.
# ---------------------------------------------------------------------------
statement ok
SET threads = 1;

query I
SELECT (SELECT list(f) FROM plink_freq('{TEST_DIR}/lv.pfile.json', counts := true) f)
    IS NOT DISTINCT FROM (SELECT list(f) FROM plink_freq('test/data/large_example.pgen', counts := true) f);
----
true

query I
SELECT (SELECT list(f) FROM plink_freq('{TEST_DIR}/ls.pfile.json', counts := true) f)
    IS NOT DISTINCT FROM (SELECT list(f) FROM plink_freq('test/data/large_example.pgen', counts := true) f);
----
true

query I
SELECT (SELECT list(f) FROM plink_freq('{TEST_DIR}/lm.pfile.json', counts := true) f)
    IS NOT DISTINCT FROM (SELECT list(f) FROM plink_freq('test/data/large_example.pgen', counts := true) f);
----
true

# The sexchr catalogs hold their blocks in the writer's CHROM order, which is not the source order.
# The catalog order is the order read_pfile reads the catalog in.
query I
SELECT (SELECT list(ID) FROM plink_freq('{TEST_DIR}/sm.pfile.json'))
     = (SELECT list(ID) FROM read_pfile('{TEST_DIR}/sm.pfile.json'));
----
true

# ---------------------------------------------------------------------------
# The oracle, at threads = 1 and threads = 4
# ---------------------------------------------------------------------------
foreach threads 1 4

statement ok
SET threads = ${threads};

# large_example, all three kinds, default columns and counts := true.
foreach cat lv ls lm

query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true)
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)));
----
3000	0	0

query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json')),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json')
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen'))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen')
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json')));
----
3000	0	0

# A sample subset by IID that spans sample blocks.
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['SAMP2', 'SAMP5', 'SAMP8'])),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['SAMP2', 'SAMP5', 'SAMP8'])
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, samples := ['SAMP2', 'SAMP5', 'SAMP8']))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, samples := ['SAMP2', 'SAMP5', 'SAMP8'])
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['SAMP2', 'SAMP5', 'SAMP8'])));
----
3000	0	0

# Integer sample indices are cohort-wide and 0-based.
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := [0, 4, 7])),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := [0, 4, 7])
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, samples := [0, 4, 7]))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, samples := [0, 4, 7])
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := [0, 4, 7])));
----
3000	0	0

# A region inside one variant block.
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, region := '2:1-5000000')),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, region := '2:1-5000000')
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, region := '2:1-5000000'))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true, region := '2:1-5000000')
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, region := '2:1-5000000')));
----
<REGEX>:[1-9][0-9]*	0	0

# A region on a chromosome that no block holds.
query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', region := '9:1-1000');
----
0

# selection := carries the same axes.
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {samples: ['SAMP3', 'SAMP6'], region: '3:1-10000000'})),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {samples: ['SAMP3', 'SAMP6'], region: '3:1-10000000'})
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', selection := {samples: ['SAMP3', 'SAMP6'], region: '3:1-10000000'}))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', selection := {samples: ['SAMP3', 'SAMP6'], region: '3:1-10000000'})
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {samples: ['SAMP3', 'SAMP6'], region: '3:1-10000000'})));
----
1000	0	0

# selection := variant_range is a cohort-wide [lo, hi) ordinal range; this one crosses a block edge.
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {variant_range: [900, 2100]})),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {variant_range: [900, 2100]})
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', selection := {variant_range: [900, 2100]}))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/large_example.pgen', selection := {variant_range: [900, 2100]})
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', selection := {variant_range: [900, 2100]})));
----
1200	0	0

endloop

# sexchr_example, all three kinds: sex-aware counts on X, Y and MT.
foreach cat sv ss sm

query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true)
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true)));
----
5	0	0

query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['M2', 'F1', 'F3'])),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['M2', 'F1', 'F3'])
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, samples := ['M2', 'F1', 'F3']))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, samples := ['M2', 'F1', 'F3'])
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, samples := ['M2', 'F1', 'F3'])));
----
5	0	0

# build := reaches the catalog read (the oracle uses the same build).
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, build := 'none')),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, build := 'none')
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, build := 'none'))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, build := 'none')
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/${cat}.pfile.json', counts := true, build := 'none')));
----
5	0	0

endloop

# A catalog whose .psam files have no SEX: as plink_freq over a .psam without SEX (NULLs on X and Y).
query III
SELECT (SELECT count(*) FROM plink_freq('{TEST_DIR}/snosex.pfile.json', counts := true)),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/snosex.pfile.json', counts := true)
                              EXCEPT ALL SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := 'test/data/sexchr_nosex.psam'))),
       (SELECT count(*) FROM (SELECT * FROM plink_freq('test/data/sexchr_example.pgen', counts := true, psam := 'test/data/sexchr_nosex.psam')
                              EXCEPT ALL SELECT * FROM plink_freq('{TEST_DIR}/snosex.pfile.json', counts := true)));
----
5	0	0

endloop

# ---------------------------------------------------------------------------
# Discovery: the same inputs as read_pfile
# ---------------------------------------------------------------------------

# A bare prefix with a '<p>.pfile.json' beside it reads the catalog.
query I
SELECT count(*) FROM (SELECT * FROM plink_freq('{TEST_DIR}/lm', counts := true)
                      EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true));
----
0

query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/lm');
----
3000

# catalog := '<path>' with no positional argument.
query I
SELECT count(*) FROM (SELECT * FROM plink_freq(catalog := '{TEST_DIR}/ls.pfile.json', counts := true)
                      EXCEPT ALL SELECT * FROM plink_freq('test/data/large_example.pgen', counts := true));
----
0

query I
SELECT count(*) FROM plink_freq(catalog := '{TEST_DIR}/ls.pfile.json');
----
3000

# catalog := true requires a catalog at the prefix.
query I
SELECT count(*) FROM plink_freq('{TEST_DIR}/lv', catalog := true);
----
3000

statement error
SELECT * FROM plink_freq('test/data/large_example', catalog := true);
----
no catalog at 'test/data/large_example.pfile.json'

# catalog := false turns discovery off: the prefix is then read as a .pgen path, which has no companions.
statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm', catalog := false);
----
plink_freq: cannot find .pvar or .bim companion

# An explicit .pgen path is a file, never a catalog.
query I
SELECT count(*) FROM plink_freq('test/data/large_example.pgen');
----
3000

# ---------------------------------------------------------------------------
# Errors: parameters that a catalog read cannot honor
# ---------------------------------------------------------------------------
statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm.pfile.json', dosage := true);
----
plink_freq: dosage := true is not supported with a catalog

statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm.pfile.json', pvar := 'test/data/large_example.pvar');
----
plink_freq: a catalog

statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm.pfile.json', psam := 'test/data/large_example.psam');
----
plink_freq: a catalog

statement error
SELECT * FROM plink_freq(catalog := '{TEST_DIR}/lm.pfile.json', psam := 'test/data/large_example.psam');
----
plink_freq: a catalog

statement error
SELECT * FROM plink_freq('test/data/large_example.pgen', catalog := '{TEST_DIR}/lm.pfile.json');
----
cannot be combined with a positional

statement error
SELECT * FROM plink_freq(catalog := '{TEST_DIR}/nope.pfile.json');
----
plink_freq: catalog file not found

statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm.pfile.json', selection := {variants: ['1:1000']});
----
arbitrary variant selection

statement error
SELECT * FROM plink_freq('{TEST_DIR}/lm.pfile.json', samples := ['NOPE']);
----
NOPE
