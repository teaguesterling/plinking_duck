# name: test/sql/read_pfile_catalog_matrix_compound.test
# description: read_pfile_catalog v2 — compound keys + ordinal_interval/value_bin cell pruning (P13 phase 2)
# group: [sql]

require plinking_duck

# ===========================================================================
# FIXTURE — compound keys on BOTH axes, tiled by explicit blocks.
#   variants = CHROM (enum) x CHUNK (ordinal_interval over POS):
#     CHROM=1/CHUNK=001  ordinal [0,2)  POS [10000,20000]  (rs1@10000, rs2@20000)
#     CHROM=1/CHUNK=002  ordinal [2,3)  POS [30000,30000]  (rs3@30000)
#     CHROM=2/CHUNK=001  ordinal [3,4)  POS [15000,15000]  (rs4@15000)   <- POS 15000 like CHROM=1 would NOT
#   samples  = GROUP (enum) x SLICE (ordinal_interval over sample_index) x age (value_bin):
#     GROUP=A/SLICE=0/age=young  [0,1)  age [20,40)
#     GROUP=A/SLICE=1/age=old    [1,2)  age [40,60)
#     GROUP=B/SLICE=0/age=young  [2,3)  age [20,40)
#     GROUP=B/SLICE=1/age=old    [3,4)  age [40,60)
# => 3 variant-blocks x 4 sample-blocks = 12 cells, each a REAL 1-sample fileset whose .pgen header
# counts match its block companions (verification reads them). Flat names in {TEST_DIR} (no PARTITION_BY).
# ===========================================================================

# ---- 12 cells (variant selection x 1-sample slice) ----
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS <= 20000)
TO '{TEST_DIR}/c_1_001_A_0' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 2, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS <= 20000)
TO '{TEST_DIR}/c_1_001_A_1' (FORMAT pfile, samples ['S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS <= 20000)
TO '{TEST_DIR}/c_1_001_B_0' (FORMAT pfile, samples ['S3']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 4, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS <= 20000)
TO '{TEST_DIR}/c_1_001_B_1' (FORMAT pfile, samples ['S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS = 30000)
TO '{TEST_DIR}/c_1_002_A_0' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 2, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS = 30000)
TO '{TEST_DIR}/c_1_002_A_1' (FORMAT pfile, samples ['S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS = 30000)
TO '{TEST_DIR}/c_1_002_B_0' (FORMAT pfile, samples ['S3']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 4, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS = 30000)
TO '{TEST_DIR}/c_1_002_B_1' (FORMAT pfile, samples ['S4']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/c_2_001_A_0' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 2, 2) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/c_2_001_A_1' (FORMAT pfile, samples ['S2']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 3, 3) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/c_2_001_B_0' (FORMAT pfile, samples ['S3']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 4, 4) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/c_2_001_B_1' (FORMAT pfile, samples ['S4']);

# ---- 3 variant-block .pvar companions (shared along the variant axis) ----
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS <= 20000)
TO '{TEST_DIR}/v_1_001' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '1' AND POS = 30000)
TO '{TEST_DIR}/v_1_002' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/v_2_001' (FORMAT pfile, samples ['S1']);

# ---- 4 sample-block .psam companions (shared along the sample axis, 1 sample each) ----
statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 1, 1) AS genotypes
      FROM read_pfile('test/data/pfile_example') WHERE CHROM = '2')
TO '{TEST_DIR}/s_A_0' (FORMAT pfile, samples ['S1']);

statement ok
COPY (SELECT CHROM, POS, ID, REF, ALT, list_slice(genotypes::TINYINT[], 2, 2) AS genotypes
