# name: test/sql/write_pvar.test
# description: COPY (query) TO 'path' (FORMAT pvar) — the .pvar text writer (P9 Phase A)
# group: [sql]

require plinking_duck

# ===========================================================================
# Round-trip: write then re-read must equal the original BOTH directions.
#
# The checks are deliberately discriminating:
#   col 1: count(orig) == count(rt)         -> catches dropped / duplicated rows
#   col 2: (orig EXCEPT rt) is empty        -> catches dropped / mangled values
#   col 3: (rt EXCEPT orig) is empty        -> catches fabricated / mangled values
# EXCEPT is set-based (a duplicated row is invisible to it alone), so the
# count-equality column is load-bearing, not redundant.
# ===========================================================================

# --- basic 5-column fileset (no extra columns) ------------------------------
statement ok
COPY (SELECT * FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/rt_pfile.pvar' (FORMAT pvar);

query III
SELECT
  (SELECT count(*) FROM read_pvar('test/data/pfile_example.pvar'))
    = (SELECT count(*) FROM read_pvar('__TEST_DIR__/rt_pfile.pvar')),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('test/data/pfile_example.pvar')
                         EXCEPT SELECT * FROM read_pvar('__TEST_DIR__/rt_pfile.pvar'))),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('__TEST_DIR__/rt_pfile.pvar')
                         EXCEPT SELECT * FROM read_pvar('test/data/pfile_example.pvar')));
----
true	0	0

# Exact ordered positional read — catches a reordered row (which the set-based
# EXCEPT cannot see when the swapped rows share a type).
query TITT
SELECT CHROM, POS, ID, REF FROM read_pvar('__TEST_DIR__/rt_pfile.pvar');
----
1	10000	rs1	A
1	20000	rs2	C
1	30000	rs3	G
2	15000	rs4	T

# Column set is exactly the 5 canonical headers, in order (catches a dropped,
# renamed, reordered, or fabricated header column directly).
query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/rt_pfile.pvar'));
----
[CHROM, POS, ID, REF, ALT]

# --- extra columns carried through (QUAL/FILTER/INFO) + NULL ("." ) cells ----
statement ok
COPY (SELECT * FROM read_pvar('test/data/comments.pvar'))
TO '__TEST_DIR__/rt_comments.pvar' (FORMAT pvar);

query III
SELECT
  (SELECT count(*) FROM read_pvar('test/data/comments.pvar'))
    = (SELECT count(*) FROM read_pvar('__TEST_DIR__/rt_comments.pvar')),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('test/data/comments.pvar')
                         EXCEPT SELECT * FROM read_pvar('__TEST_DIR__/rt_comments.pvar'))),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('__TEST_DIR__/rt_comments.pvar')
                         EXCEPT SELECT * FROM read_pvar('test/data/comments.pvar')));
----
true	0	0

query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/rt_comments.pvar'));
----
[CHROM, POS, ID, REF, ALT, QUAL, FILTER, INFO]

# --- optional typed columns (QUAL FLOAT, CM DOUBLE) + per-cell NULLs ---------
statement ok
COPY (SELECT * FROM read_pvar('test/data/optional_cols.pvar'))
TO '__TEST_DIR__/rt_optional.pvar' (FORMAT pvar);

query III
SELECT
  (SELECT count(*) FROM read_pvar('test/data/optional_cols.pvar'))
    = (SELECT count(*) FROM read_pvar('__TEST_DIR__/rt_optional.pvar')),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('test/data/optional_cols.pvar')
                         EXCEPT SELECT * FROM read_pvar('__TEST_DIR__/rt_optional.pvar'))),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('__TEST_DIR__/rt_optional.pvar')
                         EXCEPT SELECT * FROM read_pvar('test/data/optional_cols.pvar')));
----
true	0	0

query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/rt_optional.pvar'));
----
[CHROM, POS, ID, REF, ALT, QUAL, FILTER, INFO, CM]

# Typed values survive (FLOAT/DOUBLE round-trip exactly through text). Cast to
# VARCHAR so the comparison is on exact text, not sqllogictest float formatting.
query TTTTT
SELECT ID, POS::VARCHAR, QUAL::VARCHAR, FILTER, CM::VARCHAR
FROM read_pvar('__TEST_DIR__/rt_optional.pvar');
----
rs1	10000	100.0	PASS	0.5
rs2	20000	50.5	LOW_QUAL	1.2
rs3	30000	NULL	NULL	0.0

# --- zero-row (header-only) source still produces a valid header-only .pvar --
statement ok
COPY (SELECT * FROM read_pvar('test/data/header_only.pvar'))
TO '__TEST_DIR__/rt_header_only.pvar' (FORMAT pvar);

query I
SELECT count(*) FROM read_pvar('__TEST_DIR__/rt_header_only.pvar');
----
0

query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/rt_header_only.pvar'));
----
[CHROM, POS, ID, REF, ALT]

# ===========================================================================
# Negative: the in-sink (CHROM, POS) monotonicity check must THROW on disorder.
# A naive round-trip is blind to this (the file reads back self-consistent), so
# these guard against silently writing a misordered .pvar.
# ===========================================================================

# Position regression within a chromosome (ORDER BY POS DESC).
statement error
COPY (SELECT * FROM read_pvar('test/data/pfile_example.pvar') ORDER BY POS DESC)
TO '__TEST_DIR__/bad_desc.pvar' (FORMAT pvar);
----
not position-sorted

# Interleaved chromosome blocks: chrom 1 reappears after chrom 2. Built from an
# explicit VALUES relation so the row order is unambiguous (not planner-dependent).
statement error
COPY (SELECT * FROM (VALUES ('1', 10000, 'a', 'A', 'G'),
                           ('2', 15000, 'b', 'T', 'C'),
                           ('1', 20000, 'c', 'C', 'T')) t(CHROM, POS, ID, REF, ALT))
TO '__TEST_DIR__/bad_interleave.pvar' (FORMAT pvar);
----
reappears after another chromosome

# --- cleanup-on-failure: a sink throw must remove the partial override file --
# (DuckDB auto-removes only its own COPY target, never a `pvar` override.)
statement error
COPY (SELECT * FROM read_pvar('test/data/pfile_example.pvar') ORDER BY POS DESC)
TO '__TEST_DIR__/cleanup_prefix' (FORMAT pvar, pvar '__TEST_DIR__/cleanup_partial.pvar');
----
not position-sorted

statement error
SELECT count(*) FROM read_pvar('__TEST_DIR__/cleanup_partial.pvar');
----

# ===========================================================================
# Option coverage
# ===========================================================================

# --- explicit variant_fields remap: differently-named input columns ----------
# Output headers are canonicalized back to CHROM/POS/ID/REF/ALT, so the result
# round-trips against the original despite the renamed input.
statement ok
COPY (SELECT CHROM AS CONTIG, POS AS BP, ID AS SNP, REF AS A2, ALT AS A1
      FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/remap.pvar'
(FORMAT pvar, variant_fields {chrom: 'CONTIG', pos: 'BP', id: 'SNP', ref: 'A2', alt: 'A1'});

query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/remap.pvar'));
----
[CHROM, POS, ID, REF, ALT]

query III
SELECT
  (SELECT count(*) FROM read_pvar('test/data/pfile_example.pvar'))
    = (SELECT count(*) FROM read_pvar('__TEST_DIR__/remap.pvar')),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('test/data/pfile_example.pvar')
                         EXCEPT SELECT * FROM read_pvar('__TEST_DIR__/remap.pvar'))),
  (SELECT count(*) FROM (SELECT * FROM read_pvar('__TEST_DIR__/remap.pvar')
                         EXCEPT SELECT * FROM read_pvar('test/data/pfile_example.pvar')));
----
true	0	0

# --- partial variant_fields: only chrom remapped, the rest default-match -----
statement ok
COPY (SELECT CHROM AS CONTIG, POS, ID, REF, ALT FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/remap_partial.pvar' (FORMAT pvar, variant_fields {chrom: 'CONTIG'});

query I
SELECT list(column_name) FROM (DESCRIBE SELECT * FROM read_pvar('__TEST_DIR__/remap_partial.pvar'));
----
[CHROM, POS, ID, REF, ALT]

# --- pvar := path override: data lands at the override, not the COPY target --
statement ok
COPY (SELECT * FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/override_prefix' (FORMAT pvar, pvar '__TEST_DIR__/override_target.pvar');

query I
SELECT count(*) FROM read_pvar('__TEST_DIR__/override_target.pvar');
----
4

# --- missing required role: actionable bind-time error -----------------------
statement error
COPY (SELECT POS, ID, REF, ALT FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/missing_chrom.pvar' (FORMAT pvar);
----
required field 'chrom'

# --- overwrite: re-running the same COPY truncates/overwrites cleanly ---------
statement ok
COPY (SELECT * FROM read_pvar('test/data/pfile_example.pvar'))
TO '__TEST_DIR__/rt_pfile.pvar' (FORMAT pvar);

query I
SELECT count(*) FROM read_pvar('__TEST_DIR__/rt_pfile.pvar');
----
4
