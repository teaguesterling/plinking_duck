# Both edges are VALID matrices: every cell verifies.
query II
SELECT (SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/m1.pfile.json', verify_all := true)),
       (SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/n1.pfile.json', verify_all := true));
----
2	2

# PER-BLOCK POS bounds (large_example's CHROMs all share one extent, so this grid is the discriminating
# one): CHROM 1 spans [10000, 30000], CHROM 2 is the single POS 15000.
query I
SELECT count(*) FROM (SELECT decode(content) c FROM read_blob('{TEST_DIR}/n1.pfile.json'))
WHERE contains(c, '{ "keys": { "CHROM": "1", "CHUNK": "0" }, "start": 0, "stop": 3, "bounds": { "CHUNK": { "min": 10000, "max": 30000 } } }')
  AND contains(c, '{ "keys": { "CHROM": "2", "CHUNK": "0" }, "start": 3, "stop": 4, "bounds": { "CHUNK": { "min": 15000, "max": 15000 } } }');
----
1

# A window inside CHROM 1's extent but below CHROM 2's single POS: CHROM 2 drops, CHROM 1 keeps.
query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/n1.pfile.json', region := '2:10000-14999');
----
0

query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/n1.pfile.json', region := '1:10000-14999');
----
1

# CHROM 1's exact max keeps it; one past drops it.
query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/n1.pfile.json', region := '1:30000-30000');
----
1

query I
SELECT count(*) FROM read_pfile_catalog('{TEST_DIR}/n1.pfile.json', region := '1:30001-40000');
----
0

# ===========================================================================
# NEGATIVE — failures after files open: nothing is orphaned across the whole grid
# ===========================================================================

# An UPSTREAM error at var2500 (CHROM 3), after blocks CHROM=1 and CHROM=2 have CLOSED (their 2+2
# .pgen sit in staging): no catalog, no finals, no staging, no dirs left behind. The error() is in a
# projection OVER the sorted subquery, so it fires while rows stream into the sink.
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT,
             CASE WHEN ID = 'var2500' THEN error('boom at var2500') ELSE genotypes END AS genotypes
      FROM (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS))
TO '{TEST_DIR}/mid' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
boom at var2500

query II
SELECT (SELECT count(*) FROM glob('{TEST_DIR}/mid*')),
       (SELECT count(*) FROM glob('{TEST_DIR}/mid/**'));
----
0	0

# A sink-side error (an out-of-range call) after two block transitions: same guarantee.
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT,
             CASE WHEN ID = 'var2500' THEN struct_pack(SAMP1 := 7::TINYINT, SAMP2 := 0::TINYINT, SAMP3 := 0::TINYINT, SAMP4 := 0::TINYINT, SAMP5 := 0::TINYINT, SAMP6 := 0::TINYINT, SAMP7 := 0::TINYINT, SAMP8 := 0::TINYINT) ELSE genotypes END AS genotypes
      FROM (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS))
TO '{TEST_DIR}/sinkerr' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
out of range

query II
SELECT (SELECT count(*) FROM glob('{TEST_DIR}/sinkerr*')),
       (SELECT count(*) FROM glob('{TEST_DIR}/sinkerr/**'));
----
0	0

# A shard key that reappears after another value (input not grouped by the key) is rejected in the
# sink, and the blocks already closed are removed.
