# Missing parent directories are created for the target; a mid-stream failure removes them again.
# Proof without a directory listing: '{TEST_DIR}/np' can then be written as a FILE.
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT,
             CASE WHEN ID = 'var2500' THEN error('boom in np') ELSE genotypes END AS genotypes
      FROM (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS))
TO '{TEST_DIR}/np/deep/out' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
boom in np

