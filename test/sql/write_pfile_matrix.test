# name: test/sql/write_pfile_matrix.test
# description: COPY ... (FORMAT pfile, shard_by '<vcol>', shard_samples {...}) — shard BOTH axes into a pfile_catalog:2 matrix: M variant-blocks x N sample-blocks (P13-010). Oracle: the source fileset.
# group: [sql]

require plinking_duck

# Layout written into TO '<dir>/<name>' (hive labels; the catalog templates are the contract):
#   <dir>/<name>/<vcol>=<v>/variants.pvar               — M, one per variant-block
#   <dir>/<name>/GROUP=<label>/samples.psam             — N, one per sample-block (written once)
#   <dir>/<name>/<vcol>=<v>/GROUP=<label>/data.pgen     — M x N cells
#   <dir>/<name>.pfile.json                             — the v2 catalog, written LAST
# large_example: 3000 variants x 8 samples (SAMP1..SAMP8), CHROM 1/2/3 x 1000 each.
# pgen_example: 4 variants x 4 samples (SAMPLE1..4), CHROM 1 (3 variants) + CHROM 2 (1 variant).

# ===========================================================================
# NEGATIVE — bind-time rejects (no file is written)
# ===========================================================================

# The sample-axis key is the reserved name GROUP: a shard_by column of that name would put one key
# name on both axes (the reader rejects it). Case-insensitive.
statement error
COPY (SELECT *, CHROM AS "group" FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'group', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
reserved

# CHUNK is the variant axis's POS key: a shard_by column named CHUNK would declare it twice.
statement error
COPY (SELECT *, CHROM AS "CHUNK" FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHUNK', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
reserved

# A bare TINYINT[N] LIST carries no sample identity (the existing identity error).
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
needs sample identity

# Sample-orient input (rows are samples, no variant columns): the existing missing-role error.
statement error
COPY (SELECT IID, genotypes FROM read_pfile('test/data/large_example', orient := 'sample'))
TO '__TEST_DIR__/bad' (FORMAT pfile, samples ['SAMP1'], shard_by 'IID', shard_samples {a: ['SAMP1']});
----
CHROM

# The sample-shard rules still apply (ParseSampleShards is reused): a non-contiguous group.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP3'], b: ['SAMP2', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
contiguous

# Path overrides cannot be combined (the layout generates every path).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHROM', pvar '__TEST_DIR__/x.pvar', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
cannot be combined with pvar/pgen/psam path overrides

# Resource guard on N (the concurrent writer count): 250 one-sample groups at variant_count 2e9
# reserve ~750 GB, so the COPY fails at BIND, naming the mitigations.
statement error
COPY (SELECT * FROM read_pfile('test/data/pca_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '__TEST_DIR__/bad' (FORMAT pfile, shard_by 'CHROM', variant_count 2000000000, shard_samples {g0: ['per0'], g1: ['per1'], g2: ['per2'], g3: ['per3'], g4: ['per4'], g5: ['per5'], g6: ['per6'], g7: ['per7'], g8: ['per8'], g9: ['per9'], g10: ['per10'], g11: ['per11'], g12: ['per12'], g13: ['per13'], g14: ['per14'], g15: ['per15'], g16: ['per16'], g17: ['per17'], g18: ['per18'], g19: ['per19'], g20: ['per20'], g21: ['per21'], g22: ['per22'], g23: ['per23'], g24: ['per24'], g25: ['per25'], g26: ['per26'], g27: ['per27'], g28: ['per28'], g29: ['per29'], g30: ['per30'], g31: ['per31'], g32: ['per32'], g33: ['per33'], g34: ['per34'], g35: ['per35'], g36: ['per36'], g37: ['per37'], g38: ['per38'], g39: ['per39'], g40: ['per40'], g41: ['per41'], g42: ['per42'], g43: ['per43'], g44: ['per44'], g45: ['per45'], g46: ['per46'], g47: ['per47'], g48: ['per48'], g49: ['per49'], g50: ['per50'], g51: ['per51'], g52: ['per52'], g53: ['per53'], g54: ['per54'], g55: ['per55'], g56: ['per56'], g57: ['per57'], g58: ['per58'], g59: ['per59'], g60: ['per60'], g61: ['per61'], g62: ['per62'], g63: ['per63'], g64: ['per64'], g65: ['per65'], g66: ['per66'], g67: ['per67'], g68: ['per68'], g69: ['per69'], g70: ['per70'], g71: ['per71'], g72: ['per72'], g73: ['per73'], g74: ['per74'], g75: ['per75'], g76: ['per76'], g77: ['per77'], g78: ['per78'], g79: ['per79'], g80: ['per80'], g81: ['per81'], g82: ['per82'], g83: ['per83'], g84: ['per84'], g85: ['per85'], g86: ['per86'], g87: ['per87'], g88: ['per88'], g89: ['per89'], g90: ['per90'], g91: ['per91'], g92: ['per92'], g93: ['per93'], g94: ['per94'], g95: ['per95'], g96: ['per96'], g97: ['per97'], g98: ['per98'], g99: ['per99'], g100: ['per100'], g101: ['per101'], g102: ['per102'], g103: ['per103'], g104: ['per104'], g105: ['per105'], g106: ['per106'], g107: ['per107'], g108: ['per108'], g109: ['per109'], g110: ['per110'], g111: ['per111'], g112: ['per112'], g113: ['per113'], g114: ['per114'], g115: ['per115'], g116: ['per116'], g117: ['per117'], 