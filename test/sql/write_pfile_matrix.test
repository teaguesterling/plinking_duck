# name: test/sql/write_pfile_matrix.test
# description: COPY ... (FORMAT pfile, shard_by '<vcol>', shard_samples {...}) — shard BOTH axes into a pfile_catalog:2 matrix: M variant-blocks x N sample-blocks (P13-010). Oracle: the source fileset.
# group: [sql]

require plinking_duck

# Layout written into TO '<dir>/<name>' (hive labels; the catalog templates are the contract):
#   <dir>/<name>/<vcol>=<v>/variants.pvar               — M, one per variant-block
#   <dir>/<name>/GROUP=<label>/samples.psam             — N, one per sample-block (written once)
#   <dir>/<name>/<vcol>=<v>/GROUP=<label>/data.pgen     — M x N cells
#   <dir>/<name>.pfile.json                             — the v2 catalog, written LAST
# large_example: 3000 variants x 8 samples (SAMP1..SAMP8), CHROM 1/2/3 x 1000 each.
# pgen_example: 4 variants x 4 samples (SAMPLE1..4), CHROM 1 (3 variants) + CHROM 2 (1 variant).

# ===========================================================================
# NEGATIVE — bind-time rejects (no file is written)
# ===========================================================================

# The sample-axis key is the reserved name GROUP: a shard_by column of that name would put one key
# name on both axes (the reader rejects it). Case-insensitive.
statement error
COPY (SELECT *, CHROM AS "group" FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'group', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
reserved

# CHUNK is the variant axis's POS key: a shard_by column named CHUNK would declare it twice.
statement error
COPY (SELECT *, CHROM AS "CHUNK" FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHUNK', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
reserved

# A bare TINYINT[N] LIST carries no sample identity (the existing identity error).
statement error
COPY (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
needs sample identity

# Sample-orient input (rows are samples, no variant columns): the existing missing-role error.
statement error
COPY (SELECT IID, genotypes FROM read_pfile('test/data/large_example', orient := 'sample'))
TO '{TEST_DIR}/bad' (FORMAT pfile, samples ['SAMP1'], shard_by 'IID', shard_samples {a: ['SAMP1']});
----
CHROM

# The sample-shard rules still apply (ParseSampleShards is reused): a non-contiguous group.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP3'], b: ['SAMP2', 'SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
contiguous

# Path overrides cannot be combined (the layout generates every path).
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHROM', pvar '{TEST_DIR}/x.pvar', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
cannot be combined with pvar/pgen/psam path overrides

# Resource guard on N (the concurrent writer count): 250 one-sample groups at variant_count 2e9
# reserve ~750 GB, so the COPY fails at BIND, naming the mitigations.
statement error
COPY (SELECT * FROM read_pfile('test/data/pca_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'CHROM', variant_count 2000000000, shard_samples {g0: ['per0'], g1: ['per1'], g2: ['per2'], g3: ['per3'], g4: ['per4'], g5: ['per5'], g6: ['per6'], g7: ['per7'], g8: ['per8'], g9: ['per9'], g10: ['per10'], g11: ['per11'], g12: ['per12'], g13: ['per13'], g14: ['per14'], g15: ['per15'], g16: ['per16'], g17: ['per17'], g18: ['per18'], g19: ['per19'], g20: ['per20'], g21: ['per21'], g22: ['per22'], g23: ['per23'], g24: ['per24'], g25: ['per25'], g26: ['per26'], g27: ['per27'], g28: ['per28'], g29: ['per29'], g30: ['per30'], g31: ['per31'], g32: ['per32'], g33: ['per33'], g34: ['per34'], g35: ['per35'], g36: ['per36'], g37: ['per37'], g38: ['per38'], g39: ['per39'], g40: ['per40'], g41: ['per41'], g42: ['per42'], g43: ['per43'], g44: ['per44'], g45: ['per45'], g46: ['per46'], g47: ['per47'], g48: ['per48'], g49: ['per49'], g50: ['per50'], g51: ['per51'], g52: ['per52'], g53: ['per53'], g54: ['per54'], g55: ['per55'], g56: ['per56'], g57: ['per57'], g58: ['per58'], g59: ['per59'], g60: ['per60'], g61: ['per61'], g62: ['per62'], g63: ['per63'], g64: ['per64'], g65: ['per65'], g66: ['per66'], g67: ['per67'], g68: ['per68'], g69: ['per69'], g70: ['per70'], g71: ['per71'], g72: ['per72'], g73: ['per73'], g74: ['per74'], g75: ['per75'], g76: ['per76'], g77: ['per77'], g78: ['per78'], g79: ['per79'], g80: ['per80'], g81: ['per81'], g82: ['per82'], g83: ['per83'], g84: ['per84'], g85: ['per85'], g86: ['per86'], g87: ['per87'], g88: ['per88'], g89: ['per89'], g90: ['per90'], g91: ['per91'], g92: ['per92'], g93: ['per93'], g94: ['per94'], g95: ['per95'], g96: ['per96'], g97: ['per97'], g98: ['per98'], g99: ['per99'], g100: ['per100'], g101: ['per101'], g102: ['per102'], g103: ['per103'], g104: ['per104'], g105: ['per105'], g106: ['per106'], g107: ['per107'], g108: ['per108'], g109: ['per109'], g110: ['per110'], g111: ['per111'], g112: ['per112'], g113: ['per113'], g114: ['per114'], g115: ['per115'], g116: ['per116'], g117: ['per117'], g118: ['per118'], g119: ['per119'], g120: ['per120'], g121: ['per121'], g122: ['per122'], g123: ['per123'], g124: ['per124'], g125: ['per125'], g126: ['per126'], g127: ['per127'], g128: ['per128'], g129: ['per129'], g130: ['per130'], g131: ['per131'], g132: ['per132'], g133: ['per133'], g134: ['per134'], g135: ['per135'], g136: ['per136'], g137: ['per137'], g138: ['per138'], g139: ['per139'], g140: ['per140'], g141: ['per141'], g142: ['per142'], g143: ['per143'], g144: ['per144'], g145: ['per145'], g146: ['per146'], g147: ['per147'], g148: ['per148'], g149: ['per149'], g150: ['per150'], g151: ['per151'], g152: ['per152'], g153: ['per153'], g154: ['per154'], g155: ['per155'], g156: ['per156'], g157: ['per157'], g158: ['per158'], g159: ['per159'], g160: ['per160'], g161: ['per161'], g162: ['per162'], g163: ['per163'], g164: ['per164'], g165: ['per165'], g166: ['per166'], g167: ['per167'], g168: ['per168'], g169: ['per169'], g170: ['per170'], g171: ['per171'], g172: ['per172'], g173: ['per173'], g174: ['per174'], g175: ['per175'], g176: ['per176'], g177: ['per177'], g178: ['per178'], g179: ['per179'], g180: ['per180'], g181: ['per181'], g182: ['per182'], g183: ['per183'], g184: ['per184'], g185: ['per185'], g186: ['per186'], g187: ['per187'], g188: ['per188'], g189: ['per189'], g190: ['per190'], g191: ['per191'], g192: ['per192'], g193: ['per193'], g194: ['per194'], g195: ['per195'], g196: ['per196'], g197: ['per197'], g198: ['per198'], g199: ['per199'], g200: ['per200'], g201: ['per201'], g202: ['per202'], g203: ['per203'], g204: ['per204'], g205: ['per205'], g206: ['per206'], g207: ['per207'], g208: ['per208'], g209: ['per209'], g210: ['per210'], g211: ['per211'], g212: ['per212'], g213: ['per213'], g214: ['per214'], g215: ['per215'], g216: ['per216'], g217: ['per217'], g218: ['per218'], g219: ['per219'], g220: ['per220'], g221: ['per221'], g222: ['per222'], g223: ['per223'], g224: ['per224'], g225: ['per225'], g226: ['per226'], g227: ['per227'], g228: ['per228'], g229: ['per229'], g230: ['per230'], g231: ['per231'], g232: ['per232'], g233: ['per233'], g234: ['per234'], g235: ['per235'], g236: ['per236'], g237: ['per237'], g238: ['per238'], g239: ['per239'], g240: ['per240'], g241: ['per241'], g242: ['per242'], g243: ['per243'], g244: ['per244'], g245: ['per245'], g246: ['per246'], g247: ['per247'], g248: ['per248'], g249: ['per249']});
----
fewer groups

# The shard_by column name becomes a template literal + key name: '{' / '}' would make the catalog
# template unparseable, so it is rejected at bind.
statement error
COPY (SELECT *, CHROM AS "c{x}" FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad' (FORMAT pfile, shard_by 'c{x}', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
brace

# The COPY target's basename is also a template literal (the grid root): a brace there would write a
# catalog the reader cannot parse, so it is rejected at bind too.
statement error
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/bad}x' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], b: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});
----
brace

# None of the bind rejects wrote anything.
query I
SELECT count(*) FROM glob('{TEST_DIR}/bad*');
----
0

# ===========================================================================
# POSITIVE — a 3 x 2 grid (3 CHROM blocks x 2 sample-blocks), STRUCT input
# ===========================================================================

statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/g' (FORMAT pfile, shard_by 'CHROM', shard_samples {a: ['SAMP1', 'SAMP2', 'SAMP3'], b: ['SAMP4', 'SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

# The layout: M=3 .pvar, N=2 .psam, M x N = 6 .pgen; no staging left behind.
query IIII
SELECT (SELECT count(*) FROM glob('{TEST_DIR}/g/CHROM=*/variants.pvar')),
       (SELECT count(*) FROM glob('{TEST_DIR}/g/GROUP=*/samples.psam')),
       (SELECT count(*) FROM glob('{TEST_DIR}/g/CHROM=*/GROUP=*/data.pgen')),
       (SELECT count(*) FROM glob('{TEST_DIR}/g/**/*.staging*'));
----
3	2	6	0

# Each sample-block .psam is its IID slice, in order (written once, shared by every variant-block).
query T
SELECT string_agg(IID, ',') FROM read_psam('{TEST_DIR}/g/GROUP=a/samples.psam');
----
SAMP1,SAMP2,SAMP3

query T
SELECT string_agg(IID, ',') FROM read_psam('{TEST_DIR}/g/GROUP=b/samples.psam');
----
SAMP4,SAMP5,SAMP6,SAMP7,SAMP8

# Each variant-block .pvar holds exactly its CHROM's 1000 variants.
query TI
SELECT string_agg(DISTINCT CHROM, ','), count(*) FROM read_pvar('{TEST_DIR}/g/CHROM=2/variants.pvar');
----
2	1000

# Every cell equals the source restricted to (its CHROM) x (its sample slice): genotypes AND row count.
query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/g/CHROM=1/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=1/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example', samples := [0, 1, 2]) WHERE CHROM = '1')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/g/CHROM=1/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=1/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam'));
----
0	1000

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/g/CHROM=1/GROUP=b/data', pvar := '{TEST_DIR}/g/CHROM=1/variants.pvar', psam := '{TEST_DIR}/g/GROUP=b/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example', samples := [3, 4, 5, 6, 7]) WHERE CHROM = '1')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/g/CHROM=1/GROUP=b/data', pvar := '{TEST_DIR}/g/CHROM=1/variants.pvar', psam := '{TEST_DIR}/g/GROUP=b/samples.psam'));
----
0	1000

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/g/CHROM=2/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=2/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example', samples := [0, 1, 2]) WHERE CHROM = '2')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/g/CHROM=2/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=2/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam'));
----
0	1000

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/g/CHROM=2/GROUP=b/data', pvar := '{TEST_DIR}/g/CHROM=2/variants.pvar', psam := '{TEST_DIR}/g/GROUP=b/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example', samples := [3, 4, 5, 6, 7]) WHERE CHROM = '2')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/g/CHROM=2/GROUP=b/data', pvar := '{TEST_DIR}/g/CHROM=2/variants.pvar', psam := '{TEST_DIR}/g/GROUP=b/samples.psam'));
----
0	1000

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/g/CHROM=3/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=3/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/large_example', samples := [0, 1, 2]) WHERE CHROM = '3')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/g/CHROM=3/GROUP=a/data', pvar := '{TEST_DIR}/g/CHROM=3/variants.pvar', psam := '{TEST_DIR}/g/GROUP=a/samples.psam'));
----
