1	2	2

query II
SELECT (SELECT count(*) FROM (SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('{TEST_DIR}/m1/CHROM=1/GROUP=y/data', pvar := '{TEST_DIR}/m1/CHROM=1/variants.pvar', psam := '{TEST_DIR}/m1/GROUP=y/samples.psam')
        EXCEPT ALL SELECT CHROM, POS, ID, REF, ALT, genotypes FROM read_pfile('test/data/pgen_example', samples := [1, 2, 3]) WHERE CHROM = '1')),
       (SELECT count(*) FROM read_pfile('{TEST_DIR}/m1/CHROM=1/GROUP=y/data', pvar := '{TEST_DIR}/m1/CHROM=1/variants.pvar', psam := '{TEST_DIR}/m1/GROUP=y/samples.psam'));
