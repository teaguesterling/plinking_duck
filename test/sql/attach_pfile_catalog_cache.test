# name: test/sql/attach_pfile_catalog_cache.test
# description: ATTACH ... (TYPE pfile_catalog, CACHE <bool>): queries on one ATTACH reuse its catalog grid, companion paths and parsed .psam; CACHE false reads them every query
# group: [sql]

require plinking_duck

require parquet

# Spec: docs/superpowers/specs/2026-11-19-where-region-pushdown-and-attach-cache-design.md, Part 2.
# The ATTACH is a snapshot: the cache is never re-validated against the files.

# ---------------------------------------------------------------------------
# Part 1: the option and the view key
# ---------------------------------------------------------------------------
statement ok
ATTACH 'test/data/large_example' AS nc (TYPE pfile_catalog, CACHE false);

statement ok
ATTACH 'test/data/large_example' AS yc (TYPE pfile_catalog, CACHE true);

statement ok
ATTACH 'test/data/large_example' AS dc (TYPE pfile_catalog);

statement error
ATTACH 'test/data/large_example' AS bad (TYPE pfile_catalog, CACHE 'x');
----
CACHE

# The same rows with and without the cache.
query I
SELECT count(*) FROM (
  (SELECT ID, genotypes FROM nc.genotypes EXCEPT ALL SELECT ID, genotypes FROM yc.genotypes)
  UNION ALL
  (SELECT ID, genotypes FROM yc.genotypes EXCEPT ALL SELECT ID, genotypes FROM nc.genotypes));
----
0

# Only a cached ATTACH names a cache in its views (the default is CACHE true).
query II
SELECT database_name, contains(sql, 'attach_cache :=') FROM duckdb_views()
WHERE database_name IN ('nc', 'yc', 'dc') AND view_name = 'genotypes' ORDER BY ALL;
----
dc	true
nc	false
yc	true

# Two ATTACHes of one file set do not share a key.
query I
SELECT count(DISTINCT regexp_extract(sql, 'attach_cache := ''([^'']+)''', 1)) FROM duckdb_views()
WHERE database_name IN ('yc', 'dc') AND view_name = 'genotypes';
----
2

statement ok
DETACH nc;

statement ok
DETACH yc;

statement ok
DETACH dc;

# ---------------------------------------------------------------------------
# Part 2: each cached item, proved by changing the file after the first query
#   (CACHE true, same ATTACH): the first read is served again, rows unchanged;
#   (CACHE false, or a fresh ATTACH): the file is read again, so the change shows (an error).
# Oracle for "unchanged": a table of the first query. One fixture directory per item.
# ---------------------------------------------------------------------------

# --- the catalog grid (.pfile.json) ---
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/g' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
ATTACH '{TEST_DIR}/g' AS g1 (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/g' AS g0 (TYPE pfile_catalog, CACHE false);

statement ok
CREATE TABLE g_first AS SELECT ID, genotypes FROM g1.genotypes;

query I
SELECT count(*) FROM g0.genotypes;
----
3000

statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/g.pfile.json' (FORMAT csv, header false);

foreach threads 1 4

statement ok
SET threads = ${threads};

query I
SELECT count(*) FROM (
  (SELECT ID, genotypes FROM g1.genotypes EXCEPT ALL SELECT * FROM g_first)
  UNION ALL (SELECT * FROM g_first EXCEPT ALL SELECT ID, genotypes FROM g1.genotypes));
----
0

endloop

statement error
SELECT count(*) FROM g0.genotypes;
----

statement ok
DETACH g1;

# A fresh ATTACH reads the file again (here ATTACH itself parses it).
statement error
ATTACH '{TEST_DIR}/g' AS g1 (TYPE pfile_catalog);
----

# --- a sample block's .psam ---
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/p' (FORMAT pfile, shard_by 'CHROM', shard_samples {lo: ['SAMP1', 'SAMP2', 'SAMP3', 'SAMP4'], hi: ['SAMP5', 'SAMP6', 'SAMP7', 'SAMP8']});

statement ok
ATTACH '{TEST_DIR}/p' AS p1 (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/p' AS p0 (TYPE pfile_catalog, CACHE false);

statement ok
CREATE TABLE p_first AS SELECT ID, genotypes, ALT_FREQ FROM p1.genotypes;

statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/p/GROUP=hi/samples.psam' (FORMAT csv, header false);

query I
SELECT count(*) FROM (
  (SELECT ID, genotypes, ALT_FREQ FROM p1.genotypes EXCEPT ALL SELECT * FROM p_first)
  UNION ALL (SELECT * FROM p_first EXCEPT ALL SELECT ID, genotypes, ALT_FREQ FROM p1.genotypes));
----
0

statement error
SELECT count(*) FROM p0.genotypes;
----

statement ok
DETACH p1;

statement ok
ATTACH '{TEST_DIR}/p' AS p1 (TYPE pfile_catalog);

statement error
SELECT count(*) FROM p1.genotypes;
----

# --- the companion paths discovery chose (a bare file set with a text .pvar) ---
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/t' (FORMAT pfile);

statement ok
ATTACH '{TEST_DIR}/t' AS t1 (TYPE pfile_catalog);

statement ok
ATTACH '{TEST_DIR}/t' AS t0 (TYPE pfile_catalog, CACHE false);

statement ok
CREATE TABLE t_first AS SELECT ID, genotypes FROM t1.genotypes;

# A .pvar.parquet appears after the first query; discovery prefers it, and it is garbage.
statement ok
COPY (SELECT 'garbage') TO '{TEST_DIR}/t.pvar.parquet' (FORMAT csv, header false);

query I
SELECT count(*) FROM (
  (SELECT ID, genotypes FROM t1.genotypes EXCEPT ALL SELECT * FROM t_first)
  UNION ALL (SELECT * FROM t_first EXCEPT ALL SELECT ID, genotypes FROM t1.genotypes));
----
0

statement error
SELECT count(*) FROM t0.genotypes;
----

statement ok
DETACH t1;

statement ok
ATTACH '{TEST_DIR}/t' AS t1 (TYPE pfile_catalog);

statement error
SELECT count(*) FROM t1.genotypes;
----

# ---------------------------------------------------------------------------
# Part 3 (review findings): a setting that changes discovery is part of the cache key; the
# cached memory is counted, and DETACH frees it.
# ---------------------------------------------------------------------------

# A bare file set with a text .psam and a .psam.parquet whose IIDs differ (PQ_*).
statement ok
COPY (SELECT * FROM read_pfile('test/data/large_example', genotypes := 'struct') ORDER BY CHROM, POS)
TO '{TEST_DIR}/f' (FORMAT pfile);

statement ok
COPY (SELECT 'PQ_' || IID AS IID FROM read_psam('{TEST_DIR}/f.psam')) TO '{TEST_DIR}/f.psam.parquet' (FORMAT parquet);

statement ok
ATTACH '{TEST_DIR}/f' AS fa (TYPE pfile_catalog);

query T
SELECT min(IID) FROM fa.genotypes_by_sample;
----
PQ_SAMP1

# SET plinking_use_parquet_companions = false must still take effect on the cached ATTACH.
statement ok
SET plinking_use_parquet_companions = false;

query T
SELECT min(IID) FROM fa.genotypes_by_sample;
----
SAMP1

statement ok
RESET plinking_use_parquet_companions;

query T
SELECT min(IID) FROM fa.genotypes_by_sample;
----
PQ_SAMP1

statement ok
DETACH fa;

# The cache is counted in DuckDB's memory accounting (OBJECT_CACHE), and DETACH frees it.
statement ok
ATTACH 'test/data/large_example' AS ma (TYPE pfile_catalog);

statement ok
SELECT count(*) FROM ma.genotypes_by_sample;

query I
SELECT memory_usage_bytes > 0 FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE';
----
true

statement ok
DETACH ma;

query I
SELECT memory_usage_bytes FROM duckdb_memory() WHERE tag = 'OBJECT_CACHE';
----
0
