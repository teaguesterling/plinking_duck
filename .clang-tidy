Checks: >-
  -*,
  clang-diagnostic-*,
  bugprone-*,
  performance-*,
  google-explicit-constructor,
  google-build-using-namespace,
  google-runtime-int,
  misc-definitions-in-headers,
  modernize-use-nullptr,
  modernize-use-override,
  -bugprone-macro-parentheses,
  readability-braces-around-statements,
  -bugprone-branch-clone,
  readability-identifier-naming,
  hicpp-exception-baseclass,
  misc-throw-by-value-catch-by-reference,
  -bugprone-signed-char-misuse,
  -bugprone-misplaced-widening-cast,
  -bugprone-sizeof-expression,
  -bugprone-easily-swappable-parameters,
  google-global-names-in-headers,
  llvm-header-guard,
  misc-definitions-in-headers,
  modernize-use-emplace,
  modernize-use-bool-literals,
  -performance-inefficient-string-concatenation,
  -performance-no-int-to-ptr,
  readability-container-size-empty,
  cppcoreguidelines-pro-type-cstyle-cast,
  -llvm-header-guard,
  -performance-enum-size,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-avoid-non-const-global-variables,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-virtual-class-destructor,
  -readability-identifier-naming,
  -bugprone-unused-local-non-trivial-variable,
  -bugprone-empty-catch,
  -misc-use-internal-linkage,
  -readability-static-definition-in-anonymous-namespace
# plinking_duck tidy policy. This file was a symlink to duckdb/.clang-tidy, which
# made the gate track the duckdb submodule pin (the same failure #62 fixed for
# .clang-format). It is now a real, owned file. The Checks list is kept verbatim
# from duckdb so every check still RUNS and is visible in the log; we only narrow
# WarningsAsErrors, so most checks are advisory and a defined high-value subset
# blocks CI. Advisory (visible, non-blocking) by deliberate choice, every call
# measured on CI run 39158116861, not inferred:
#   google-runtime-int (246)            -> plinking mirrors plink2's fixed-width
#                                          integer types at the C-API boundary.
#   bugprone-narrowing-conversions (42) -> confined to plink2_glm_logistic_math.cpp,
#                                          a numeric kernel ported from plink2; the
#                                          int widths mirror upstream.
#   bugprone-implicit-widening-of-multiplication-result (56) -> all 28 sites checked,
#                                          every one bounded (index x small constant,
#                                          or predictor x sample, predictors small);
#                                          no variant_ct x sample_ct buffer multiply.
#   bugprone-multi-level-implicit-pointer-conversion (24) -> void**/void* plink2
#                                          C-API interop idiom.
# bugprone-use-after-move is now BLOCKING (via bugprone-* with no exclusion). Its one
# finding, a move inside the plink_pca mode:='both' output loop, was measured NOT
# reachable (DuckDB dedupes a table function's column_ids) and then hoisted out of the
# loop in #66, so the check is clean and now guards against any reachable use-after-move.
#   cppcoreguidelines-pro-type-const-cast (6) -> DuckDB/plink2 C-API takes non-const,
#                                          plus one lazy-init cache.
#   google-build-using-namespace (2)    -> `using namespace plink2;` in a C-API-heavy
#                                          translation unit.
# google-explicit-constructor is BLOCKING: the "24" findings were one site, the
# AlignedAllocator rebinding constructor in plink_common.hpp, which must stay implicit
# per the C++ Allocator requirement. That one line is NOLINT-suppressed with a reason;
# the check now catches any new single-argument constructor that should be explicit.
#   performance-*, rvalue-reference-param-not-moved, avoid-non-const-global-variables,
#   misc-*                              -> style/noise on this codebase for now.
WarningsAsErrors: >-
  clang-diagnostic-*,
  bugprone-*,
  -bugprone-narrowing-conversions,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-implicit-widening-of-multiplication-result,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-emplace,
  modernize-use-bool-literals,
  google-explicit-constructor,
  readability-braces-around-statements,
  readability-container-size-empty,
  hicpp-exception-baseclass,
  misc-throw-by-value-catch-by-reference,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-interfaces-global-init
HeaderFilterRegex: 'src/include/.*'
FormatStyle:     none
CheckOptions:
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypedefCase
    value:           lower_case
  - key:             readability-identifier-naming.TypedefSuffix
    value:           _t
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             readability-identifier-naming.MemberCase
    value:           lower_case
  - key:             readability-identifier-naming.ParameterCase
    value:           lower_case
  - key:             readability-identifier-naming.ConstantCase
    value:           aNy_CasE
  - key:             readability-identifier-naming.ConstantParameterCase
    value:           lower_case
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  - key:             readability-identifier-naming.MacroDefinitionCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.StaticConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.ConstantMemberCase
    value:           aNy_CasE
  - key:             readability-identifier-naming.StaticVariableCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.ClassConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.EnumConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.ConstexprVariableCase
    value:           aNy_CasE
  - key:             readability-identifier-naming.StaticConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.TemplateTemplateParameterCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.TypeTemplateParameterCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             modernize-use-emplace.SmartPointers
    value:           '::duckdb::shared_ptr;::duckdb::unique_ptr;::std::auto_ptr;::duckdb::weak_ptr'
  - key:             cppcoreguidelines-rvalue-reference-param-not-moved.IgnoreUnnamedParams
    value:           true
  - key:             misc-use-internal-linkage
    value:           true
  - key:             readability-static-definition-in-anonymous-namespace
    value:           true